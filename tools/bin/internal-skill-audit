#!/usr/bin/env -S uv run --script
"""Audit internal SKILL.md files for skill-conventions.md conformance.

Scans skill bundles authored in this repo against the conventions in
dev-playbook's standards/skill-conventions.md. Two skill roots are checked
when present in the target directory:

  - .claude/skills/                (project-level skills, any repo)
  - dotfiles/dot-claude/skills/    (workspace-global skills, dev-playbook only)

Externally-managed skills (those whose bundle directory is a symlink,
typically pointing into dotfiles/.agents/skills/) are skipped — their
conformance is the upstream's concern. Exits 0 silently when neither root
exists, so the same invocation is safe in any repo.

Usage:
    internal-skill-audit [directory]
"""
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path

import yaml

REQUIRED_FIELDS = ("name", "description", "disable-model-invocation", "model", "effort")
BANNED_FIELDS = ("user-invocable",)
VALID_MODELS = ("haiku", "sonnet", "opus")
VALID_EFFORTS = ("low", "medium", "high", "xhigh")
KEBAB_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
LINK_RE = re.compile(r"\[[^\]]+\]\(([^)]+)\)")
DESCRIPTION_MAX = 1024
BODY_MAX_LINES = 100


@dataclass
class Finding:
    file: str
    check: str
    message: str
    level: str = "error"  # "error" fails exit code; "warn" prints but does not fail

    def __str__(self) -> str:
        return f"{self.file}:{self.check}:{self.level}: {self.message}"


def parse_skill(path: Path) -> tuple[dict | None, str]:
    """Parse YAML front matter and body from a SKILL.md file."""
    text = path.read_text()
    if not text.startswith("---\n"):
        return None, text

    end = text.index("\n---\n", 4)
    front_matter = yaml.safe_load(text[4:end])
    body = text[end + 5 :]
    return front_matter, body


def check_required_fields(fm: dict, rel: str) -> list[Finding]:
    return [
        Finding(rel, "required-field", f"missing '{field}'")
        for field in REQUIRED_FIELDS
        if field not in fm
    ]


def check_banned_fields(fm: dict, rel: str) -> list[Finding]:
    return [
        Finding(rel, "banned-field", f"'{field}' must not be present")
        for field in BANNED_FIELDS
        if field in fm
    ]


def check_name(fm: dict, dir_name: str, rel: str) -> list[Finding]:
    findings = []
    name = fm.get("name")
    if name is None:
        return findings

    if name != dir_name:
        findings.append(
            Finding(
                rel,
                "name-match",
                f"name '{name}' does not match directory '{dir_name}'",
            )
        )
    if not KEBAB_RE.match(name):
        findings.append(Finding(rel, "name-format", f"name '{name}' is not kebab-case"))
    return findings


def check_description(fm: dict, rel: str) -> list[Finding]:
    findings = []
    desc = fm.get("description")
    if desc is None:
        return findings
    if not isinstance(desc, str):
        return [
            Finding(
                rel,
                "description-type",
                f"description must be a string, got {type(desc).__name__}",
            )
        ]

    if len(desc) > DESCRIPTION_MAX:
        findings.append(
            Finding(
                rel,
                "description-length",
                f"description is {len(desc)} chars (max {DESCRIPTION_MAX})",
            )
        )

    if fm.get("disable-model-invocation") is False and "Use when" not in desc:
        findings.append(
            Finding(
                rel,
                "description-trigger",
                "auto-invocable description should include a 'Use when …' sentence "
                "naming trigger keywords/contexts/file types",
            )
        )

    return findings


def check_model(fm: dict, rel: str) -> list[Finding]:
    model = fm.get("model")
    if model is None:
        return []
    if model not in VALID_MODELS:
        return [Finding(rel, "model-value", f"model '{model}' not in {VALID_MODELS}")]
    return []


def check_effort(fm: dict, rel: str) -> list[Finding]:
    effort = fm.get("effort")
    if effort is None:
        return []
    if effort not in VALID_EFFORTS:
        return [
            Finding(rel, "effort-value", f"effort '{effort}' not in {VALID_EFFORTS}")
        ]
    return []


def check_disable_model_invocation(fm: dict, rel: str) -> list[Finding]:
    value = fm.get("disable-model-invocation")
    if value is None:
        return []
    if not isinstance(value, bool):
        return [
            Finding(
                rel,
                "dmi-type",
                f"disable-model-invocation must be boolean, got '{value}'",
            )
        ]
    return []


def check_body_h1(body: str, rel: str) -> list[Finding]:
    for line in body.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("# "):
            return []
        return [
            Finding(rel, "body-h1", f"body must start with H1, got: '{stripped[:40]}'")
        ]
    return [Finding(rel, "body-h1", "body is empty")]


def check_body_length(body: str, rel: str) -> list[Finding]:
    n = len(body.splitlines())
    if n > BODY_MAX_LINES:
        return [
            Finding(
                rel,
                "body-length",
                f"SKILL.md body is {n} lines (>{BODY_MAX_LINES}); consider spilling into references/",
                level="warn",
            )
        ]
    return []


def check_references_depth(skill_dir: Path, rel_dir: str) -> list[Finding]:
    refs_dir = skill_dir / "references"
    if not refs_dir.is_dir():
        return []

    findings = []
    refs_resolved = refs_dir.resolve()
    for md_file in sorted(refs_dir.glob("*.md")):
        rel_md = f"{rel_dir}/references/{md_file.name}"
        text = md_file.read_text()
        for match in LINK_RE.finditer(text):
            target = match.group(1).split("#", 1)[0].strip()
            if not target or target.startswith(
                ("http://", "https://", "mailto:", "~", "/")
            ):
                continue
            try:
                resolved = (md_file.parent / target).resolve()
            except OSError:
                continue
            if (
                resolved != md_file.resolve()
                and resolved.parent == refs_resolved
                and resolved.suffix == ".md"
            ):
                findings.append(
                    Finding(
                        rel_md,
                        "references-depth",
                        f"link to sibling reference file '{target}' "
                        "(references/ must be one level deep)",
                    )
                )
    return findings


def audit_skill(skill_dir: Path, repo_root: Path) -> list[Finding]:
    skill_md = skill_dir / "SKILL.md"
    if not skill_md.is_file():
        return []

    rel = str(skill_md.relative_to(repo_root))
    rel_dir = str(skill_dir.relative_to(repo_root))
    dir_name = skill_dir.name

    try:
        fm, body = parse_skill(skill_md)
    except Exception as e:
        return [Finding(rel, "parse", str(e))]

    if fm is None:
        return [Finding(rel, "front-matter", "no YAML front matter found")]

    findings = []
    findings.extend(check_required_fields(fm, rel))
    findings.extend(check_banned_fields(fm, rel))
    findings.extend(check_name(fm, dir_name, rel))
    findings.extend(check_description(fm, rel))
    findings.extend(check_model(fm, rel))
    findings.extend(check_effort(fm, rel))
    findings.extend(check_disable_model_invocation(fm, rel))
    findings.extend(check_body_h1(body, rel))
    findings.extend(check_body_length(body, rel))
    findings.extend(check_references_depth(skill_dir, rel_dir))
    return findings


def discover_internal_skills(skills_dir: Path) -> tuple[list[Path], int]:
    """Return (internal_skill_dirs, externally_managed_count).

    A skill is "externally managed" when its bundle directory is a symlink —
    typically a Stow-style symlink into dotfiles/.agents/skills/. Those
    skills are owned upstream; their conformance is not this repo's concern.
    """
    internal = []
    skipped = 0
    for entry in sorted(skills_dir.iterdir()):
        if not entry.is_dir():
            continue
        if entry.is_symlink():
            skipped += 1
            continue
        internal.append(entry)
    return internal, skipped


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Repository root to scan (default: current directory)",
    )
    args = parser.parse_args()

    repo_root = Path(args.directory).resolve()

    skill_roots = [
        p
        for p in (
            repo_root / ".claude" / "skills",
            repo_root / "dotfiles" / "dot-claude" / "skills",
        )
        if p.is_dir()
    ]

    if not skill_roots:
        print("internal-skill-audit: no skill roots found", file=sys.stderr)
        sys.exit(0)

    internal_skills: list[Path] = []
    skipped = 0
    for root in skill_roots:
        roots_internal, roots_skipped = discover_internal_skills(root)
        internal_skills.extend(roots_internal)
        skipped += roots_skipped

    if not internal_skills:
        print("internal-skill-audit: no internal skills found", file=sys.stderr)
        sys.exit(0)

    all_findings = []
    for skill_dir in internal_skills:
        all_findings.extend(audit_skill(skill_dir, repo_root))

    for f in all_findings:
        print(f)

    errors = sum(1 for f in all_findings if f.level == "error")
    warnings = sum(1 for f in all_findings if f.level == "warn")
    skills = len(internal_skills)
    suffix = f" (skipped {skipped} external)" if skipped else ""
    if errors or warnings:
        print(
            f"internal-skill-audit: {skills} internal skills, "
            f"{errors} error(s), {warnings} warning(s){suffix}",
            file=sys.stderr,
        )
    else:
        print(
            f"internal-skill-audit: {skills} internal skills, all ok{suffix}",
            file=sys.stderr,
        )

    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
