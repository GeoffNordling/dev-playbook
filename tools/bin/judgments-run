"""judgments-run — deterministic plan/render/record over judgment declarations.

Thin shim over the judgments.runner library: resolve the repo's [tool.judgments]
config, load and validate declarations, and run the requested subcommand. See
that module for the logic and its tests.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from judgments.runner import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
