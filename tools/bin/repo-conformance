#!/usr/bin/env python3
"""Check repositories against the repo documentation standard.

Scans repos for required files, misplaced files, and unknown root-level
markdown files. Produces a structured report with PASS/FAIL/WARN results.

Usage:
    repo-conformance /path/to/repo          # Check a single repo
    repo-conformance --all                   # Check all repos in workplace
    repo-conformance --all /path/to/workspace
"""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from devtools_lib.workspace import find_workplace, list_repos

# Files that must exist at repo root.
REQUIRED_FILES = {"README.md", "CLAUDE.md"}

# Files recognized at repo root (no warning if present).
RECOGNIZED_ROOT_MD = {
    "README.md",
    "CLAUDE.md",
    "ROADMAP.md",
    "BUSINESS_CONTEXT.md",
    "SECURITY.md",
    "ATTRIBUTION.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "CONTRIBUTING.md",
}

# Files that have a required location (must be at root if they exist anywhere).
LOCATION_CHECKED = {"ROADMAP.md"}

# Directories to exclude when scanning for misplaced files.
SCAN_EXCLUDE_DIRS = {
    ".git",
    ".venv",
    ".hatch",
    ".pytest_cache",
    ".claude",
    ".kiro",
    ".amazonq",
    "node_modules",
    "__pycache__",
    "cdk.out",
    "dist-info",
}

# Extra repos to skip beyond the global SKIP_DIRS.
EXTRA_SKIP: set[str] = set()

FAIL = "FAIL"
WARN = "WARN"
PASS_ = "PASS"


def find_file_anywhere(repo: Path, filename: str) -> list[Path]:
    """Find all occurrences of filename in repo, excluding ignored dirs."""
    matches = []
    for dirpath, dirnames, filenames in os.walk(repo):
        dirnames[:] = [d for d in dirnames if d not in SCAN_EXCLUDE_DIRS]
        if filename in filenames:
            matches.append(Path(dirpath) / filename)
    return matches


def check_repo(repo: Path) -> list[tuple[str, str]]:
    """Check a single repo. Returns list of (severity, message) tuples."""
    results = []

    # Required files.
    for f in sorted(REQUIRED_FILES):
        if (repo / f).exists():
            results.append((PASS_, f"{f} exists"))
        else:
            results.append((FAIL, f"{f} missing"))

    # Location checks: find files that should be at root but exist elsewhere.
    for f in sorted(LOCATION_CHECKED):
        occurrences = find_file_anywhere(repo, f)
        root_path = repo / f
        non_root = [p for p in occurrences if p != root_path]

        if non_root and not root_path.exists():
            rel_paths = [str(p.relative_to(repo)) for p in non_root]
            results.append(
                (FAIL, f"{f} found at {', '.join(rel_paths)} — expected at root")
            )

    # Unknown root-level markdown files.
    if repo.exists():
        root_md_files = sorted(repo.glob("*.md"))
        for md in root_md_files:
            if md.name not in RECOGNIZED_ROOT_MD:
                results.append((WARN, f"{md.name} — unknown root-level markdown file"))

    # Special case: project-template generated files.
    template_dir = repo / "{{ cookiecutter.project_slug }}"
    if template_dir.exists():
        for f in sorted(REQUIRED_FILES):
            if (template_dir / f).exists():
                results.append((PASS_, f"template/{f} exists"))
            else:
                results.append(
                    (FAIL, f"template/{f} missing — generated repos won't conform")
                )

    return results


def print_report(repo: Path, results: list[tuple[str, str]]) -> None:
    """Print formatted results for one repo."""
    print(f"\n=== {repo.name} ===")
    for severity, message in results:
        print(f"  {severity:4s}  {message}")


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "path",
        nargs="?",
        default=None,
        help="Path to a single repo, or workspace dir with --all",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Check all repos in workspace directory",
    )
    args = parser.parse_args()

    if args.all:
        workspace = Path(args.path) if args.path else find_workplace()
        repos = list_repos(workspace, skip=EXTRA_SKIP, require_git=False)
    elif args.path:
        repos = [Path(args.path)]
    else:
        parser.print_help()
        sys.exit(2)

    total = 0
    total_pass = 0
    total_warn = 0
    total_fail = 0

    for repo in repos:
        results = check_repo(repo)
        print_report(repo, results)

        has_fail = any(s == FAIL for s, _ in results)
        has_warn = any(s == WARN for s, _ in results)

        total += 1
        if has_fail:
            total_fail += 1
        elif has_warn:
            total_warn += 1
        else:
            total_pass += 1

    print(
        f"\nSummary: {total} repos checked, "
        f"{total_pass} pass, {total_warn} warnings only, {total_fail} with failures"
    )

    sys.exit(1 if total_fail > 0 else 0)


if __name__ == "__main__":
    main()
