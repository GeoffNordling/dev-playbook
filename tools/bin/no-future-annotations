#!/usr/bin/env python3
"""Flag ``from __future__ import annotations`` in Python files.

This workspace targets Python >= 3.11, where every motivation for the import
is already met by the language: PEP 604 unions (``X | Y``), builtin generics
(``list[int]``, ``dict[str, int]``), and forward references all work at
runtime without postponed evaluation. The import is dead weight here and is
banned across the workspace.

Walks every ``*.py`` file plus any extensionless file whose first line is a
Python shebang under the given paths (defaults to current directory). Skips
the usual cache, build, and virtualenv directories. Uses AST parsing so
string literals and docstrings cannot trigger false positives.

Usage:
    no-future-annotations [path ...]

Exits 0 if clean, 1 if any findings, 2 on tool error. One finding per line
to stdout in ``file:line  rule  message`` form; one-line summary to stderr.
"""
# /// script
# requires-python = ">=3.11"
# ///

import argparse
import ast
import os
import sys
from dataclasses import dataclass
from pathlib import Path

EXCLUDE_DIRS = {
    ".git",
    ".venv",
    ".hatch",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    "__pycache__",
    "node_modules",
    "build",
    "dist",
    # Workspace conventions: code we don't police.
    ".agents",  # externally-managed skills (dotfiles/.agents/)
    ".dhub",  # externally-managed (dotfiles/.dhub/)
    "deprecated",  # legacy code kept for reference
}

PYTHON_SHEBANG_PREFIXES = (
    "#!/usr/bin/env python",
    "#!/usr/bin/python",
    "#!/usr/bin/env -S uv run --script",
)

RULE = "no-future-annotations"
MESSAGE = "`from __future__ import annotations` is banned (Python >= 3.11)"


@dataclass(frozen=True)
class Finding:
    file: Path
    line: int

    def render(self) -> str:
        return f"{self.file}:{self.line}  {RULE}  {MESSAGE}"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="no-future-annotations",
        description=(
            "Flag `from __future__ import annotations` in Python files. "
            "The import is dead weight on Python >= 3.11."
        ),
    )
    parser.add_argument(
        "paths",
        nargs="*",
        type=Path,
        help="files or directories to scan (default: current directory)",
    )
    args = parser.parse_args(argv)

    paths = args.paths or [Path(".")]
    files = _find_python_files(paths)
    if not files:
        print(f"{RULE}: no Python files found", file=sys.stderr)
        return 0

    findings: list[Finding] = []
    for file in files:
        findings.extend(_scan_file(file))

    for f in findings:
        print(f.render())

    if findings:
        print(
            f"{RULE}: {len(findings)} finding(s) across {len(files)} files",
            file=sys.stderr,
        )
        return 1
    print(f"{RULE}: clean across {len(files)} files", file=sys.stderr)
    return 0


def _find_python_files(paths: list[Path]) -> list[Path]:
    files: set[Path] = set()
    for base in paths:
        if not base.exists():
            continue
        if base.is_file():
            if _looks_python(base):
                files.add(base)
            continue
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = [d for d in dirnames if d not in EXCLUDE_DIRS]
            for fname in filenames:
                p = Path(dirpath) / fname
                if _looks_python(p):
                    files.add(p)
    return sorted(files)


def _looks_python(path: Path) -> bool:
    if path.suffix == ".py":
        return True
    if path.suffix:
        return False
    try:
        with path.open("rb") as fh:
            first = fh.readline(256).decode("utf-8", errors="replace")
    except OSError:
        return False
    return any(first.startswith(s) for s in PYTHON_SHEBANG_PREFIXES)


def _scan_file(path: Path) -> list[Finding]:
    try:
        source = path.read_text(encoding="utf-8")
    except OSError:
        return []
    try:
        tree = ast.parse(source, filename=str(path))
    except SyntaxError:
        return []
    findings: list[Finding] = []
    for node in ast.walk(tree):
        if isinstance(node, ast.ImportFrom) and node.module == "__future__":
            for alias in node.names:
                if alias.name == "annotations":
                    findings.append(Finding(file=path, line=node.lineno))
                    break
    return findings


if __name__ == "__main__":
    raise SystemExit(main())
