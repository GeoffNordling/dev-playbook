#!/usr/bin/env python3
"""Check cross-references in markdown files.

Scans every .md file under the invoking repo for ~/workspace/<repo>/... paths,
resolves each to a file-or-directory on disk, and classifies it as ok or
broken. References inside the invoking repo are resolved against the working
copy (worktree-safe). References to other workspace repos are resolved
against the absolute on-disk path. Fenced code blocks are skipped. Files
inside any `adr/` directory are skipped as well — ADRs are immutable
historical records, so broken refs in them are accepted as expected
staleness, not lint errors.

Fragment anchors (`#heading-slug`) on .md targets are validated against the
target's headings per the slug rule in `standards/repo-documentation.md`.
Headings inside the target's fenced code blocks are ignored. Fragments on
directories or non-.md targets are out of scope and treated as `ok`.

Output:
    stdout — JSON Lines, one record per reference: {source, line, target, status}.
             Default: only status="broken" records. With --all: every reference.
    stderr — one human-readable summary line.
    exit   — 0 clean, 1 broken refs found, 2 cannot run.

Usage:
    ref-check [--all] [directory]
"""
# /// script
# requires-python = ">=3.11"
# ///

import argparse
import functools
import json
import os
import re
import subprocess
import sys
from pathlib import Path

EXCLUDE_DIRS = {
    ".git",
    ".venv",
    ".hatch",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    "__pycache__",
    "node_modules",
    # ADRs are immutable historical records (per
    # standards/adr-conventions.md). A file an ADR references may later
    # move or be deleted; we cannot update the link without editing the
    # ADR. ref-check treats broken refs inside docs/adr/ as expected
    # staleness. References from other files TO ADRs are still validated.
    "adr",
}

REF_PATTERN = re.compile(r"~/workspace/[^ )`\n]+")
FENCE_PATTERN = re.compile(r"^\s*(```|~~~)")
INLINE_CODE_PATTERN = re.compile(r"`[^`\n]*`")
HEADING_PATTERN = re.compile(r"^\s{0,3}#{1,6}\s+(.+?)\s*#*\s*$")

# Slug rule: see standards/repo-documentation.md "Fragment anchors".
SLUG_BACKTICK = re.compile(r"`([^`]*)`")
SLUG_LINK = re.compile(r"\[([^\]]*)\]\([^)]*\)")
SLUG_EMPHASIS = re.compile(r"(\*{1,2}|_{1,2})(.+?)\1")
SLUG_DROP = re.compile(r"[^\w\s\-]", re.UNICODE)
SLUG_WHITESPACE = re.compile(r"\s")


def github_slug(heading_text: str) -> str:
    """Compute the GitHub-style anchor slug for a heading.

    Steps mirror standards/repo-documentation.md "Fragment anchors":
    strip inline markdown (backticks, link syntax, emphasis), lowercase,
    drop non-word/non-whitespace/non-hyphen chars, then whitespace -> "-".
    """
    text = SLUG_BACKTICK.sub(r"\1", heading_text)
    text = SLUG_LINK.sub(r"\1", text)
    text = SLUG_EMPHASIS.sub(r"\2", text)
    text = text.lower()
    text = SLUG_DROP.sub("", text)
    text = SLUG_WHITESPACE.sub("-", text)
    return text


@functools.cache
def heading_slugs(filepath: Path) -> frozenset[str]:
    """Return the set of GitHub slugs for every ATX heading in filepath.

    Headings inside fenced code blocks are skipped. Cached by path so a
    target referenced from many sources is only parsed once per run.
    """
    slugs: set[str] = set()
    in_fence = False
    with open(filepath, encoding="utf-8", errors="replace") as f:
        for line in f:
            if FENCE_PATTERN.match(line):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            m = HEADING_PATTERN.match(line)
            if m:
                slugs.add(github_slug(m.group(1)))
    return frozenset(slugs)


def workspace_root() -> Path:
    return Path.home() / "workspace"


def canonical_repo_name(repo_root: Path) -> str:
    """Repo name from git, identical for main checkout and any worktree of it.

    Uses `git rev-parse --git-common-dir`, which points at the shared .git
    directory regardless of which worktree you're standing in. The parent of
    that directory is the repo's canonical on-disk name.

    Exits 2 if `repo_root` is not inside a git repo.
    """
    result = subprocess.run(
        ["git", "-C", str(repo_root), "rev-parse", "--git-common-dir"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"ref-check: not a git repository: {repo_root}", file=sys.stderr)
        sys.exit(2)
    common = Path(result.stdout.strip())
    if not common.is_absolute():
        common = (repo_root / common).resolve()
    return common.parent.name


def find_md_files(root: Path) -> list[Path]:
    """All .md files under root, excluding ignored directories."""
    results = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in EXCLUDE_DIRS]
        for f in filenames:
            if f.endswith(".md"):
                results.append(Path(dirpath) / f)
    return sorted(results)


def classify_ref(target: Path, fragment: str, repo_root: Path, repo_name: str) -> str:
    """Return 'ok' if target (and fragment, if any) resolves; 'broken' otherwise.

    File-existence failure short-circuits — anchor is not checked when the
    file is missing. Fragments on directories or non-.md targets are out
    of scope and treated as 'ok'.
    """
    rel = target.relative_to(workspace_root())
    target_repo = rel.parts[0]
    actual = repo_root / Path(*rel.parts[1:]) if target_repo == repo_name else target
    if not actual.exists():
        return "broken"
    if not fragment:
        return "ok"
    if not actual.is_file() or actual.suffix.lower() != ".md":
        return "ok"
    return "ok" if fragment in heading_slugs(actual) else "broken"


def scan_file(filepath: Path, repo_root: Path, repo_name: str) -> list[dict]:
    """Extract and classify every reference in one .md file."""
    results = []
    source = str(filepath.relative_to(repo_root))
    in_fence = False
    with open(filepath) as f:
        for line_num, line in enumerate(f, start=1):
            if FENCE_PATTERN.match(line):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            stripped = INLINE_CODE_PATTERN.sub("", line)
            for match in REF_PATTERN.finditer(stripped):
                target_str = match.group(0)
                path_str, _, fragment = target_str.partition("#")
                resolved = Path(path_str.replace("~", str(Path.home())))
                results.append(
                    {
                        "source": source,
                        "line": line_num,
                        "target": target_str,
                        "status": classify_ref(
                            resolved, fragment, repo_root, repo_name
                        ),
                    }
                )
    return results


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Repository root to scan (default: current directory)",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Emit JSON for every reference, not just broken ones",
    )
    args = parser.parse_args()

    repo_root = Path(args.directory).resolve()
    repo_name = canonical_repo_name(repo_root)

    md_files = find_md_files(repo_root)
    if not md_files:
        print(f"ref-check: no .md files found in {repo_root}", file=sys.stderr)
        sys.exit(2)

    total = 0
    broken = 0
    for filepath in md_files:
        for ref in scan_file(filepath, repo_root, repo_name):
            total += 1
            if ref["status"] == "broken":
                broken += 1
            if args.all or ref["status"] == "broken":
                print(json.dumps(ref))

    if total == 0:
        print(f"ref-check: no cross-references found in {repo_root}", file=sys.stderr)
        sys.exit(0)
    if broken:
        print(f"ref-check: {broken}/{total} broken", file=sys.stderr)
        sys.exit(1)
    print(f"ref-check: {total} references, all ok", file=sys.stderr)
    sys.exit(0)


if __name__ == "__main__":
    main()
