#!/usr/bin/env python3
"""Check cross-references in markdown files.

Scans the .md files in the invoking git checkout — discovered via
`git ls-files`, so discovery honors `.gitignore` and is scoped to the current
worktree — and validates the two workspace cross-reference forms defined in
standards/repo-documentation.md:

  - **Link** — a root-absolute `/path` target, written only inside markdown
    link syntax `[text](/path)`. It resolves against the invoking checkout's
    own root (the current working directory), so a worktree validates against
    its own working copy, not the main checkout.
  - **Citation** — a `~/workspace/<repo>/...` path. A citation into the
    invoking repo resolves against that same working copy (worktree-safe); a
    citation into another workspace repo resolves against its absolute on-disk
    path.

Bare `/slash` tokens (e.g. `/commit`) and backticked filenames are prose, not
Links — only `/` targets inside link syntax are checked, matching the standard.
Fenced code blocks and inline code spans are skipped. Files inside any `adr/`
directory are skipped as reference *sources* — ADRs are immutable historical
records, so broken refs in them are accepted staleness, not lint errors;
references *to* ADRs from other files are still validated.

Fragment anchors (`#heading-slug`) on .md targets are validated against the
target's headings per the slug rule in standards/repo-documentation.md.
Headings inside the target's fenced code blocks are ignored. Fragments on
directories or non-.md targets are out of scope and treated as `ok`.

Output:
    stdout — JSON Lines, one record per reference: {source, line, target, status}.
             Default: only status="broken" records. With --all: every reference.
    stderr — one human-readable summary line.
    exit   — 0 clean, 1 broken refs found, 2 cannot run.

Usage:
    ref-check [--all] [directory]
"""
# /// script
# requires-python = ">=3.11"
# ///

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from lib import md  # noqa: E402

# ADRs are immutable historical records (per standards/adr-conventions.md). A
# file an ADR references may later move or be deleted; we cannot update the link
# without editing the ADR. ref-check treats broken refs inside docs/adr/ as
# expected staleness. References from other files TO ADRs are still validated.
EXCLUDE_DIRS = {"adr"}


def workspace_root() -> Path:
    return Path.home() / "workspace"


def canonical_repo_name(repo_root: Path) -> str:
    """Repo name from git, identical for main checkout and any worktree of it.

    Uses `git rev-parse --git-common-dir`, which points at the shared .git
    directory regardless of which worktree you're standing in. The parent of
    that directory is the repo's canonical on-disk name.

    Exits 2 if `repo_root` is not inside a git repo.
    """
    result = subprocess.run(
        ["git", "-C", str(repo_root), "rev-parse", "--git-common-dir"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        print(f"ref-check: not a git repository: {repo_root}", file=sys.stderr)
        sys.exit(2)
    common = Path(result.stdout.strip())
    if not common.is_absolute():
        common = (repo_root / common).resolve()
    return common.parent.name


def source_files(repo_root: Path) -> list[Path]:
    """All scannable .md files: every tracked/untracked .md minus adr sources."""
    return [
        p
        for p in md.find_md_files(repo_root)
        if not (EXCLUDE_DIRS & set(p.relative_to(repo_root).parts))
    ]


def resolve_citation(target: Path, repo_root: Path, repo_name: str) -> Path:
    """Map a ~/workspace citation to the on-disk path that should hold it.

    In-repo citations resolve against repo_root — the working copy of the
    invoking checkout, which may be a worktree — so edits resolve against the
    worktree's state, not the main checkout. Cross-repo citations use the
    absolute on-disk path as written.
    """
    rel = target.relative_to(workspace_root())
    if rel.parts and rel.parts[0] == repo_name:
        return repo_root / Path(*rel.parts[1:])
    return target


def status_of(actual: Path, fragment: str) -> str:
    """Return 'ok' if actual (and fragment, if any) resolves; 'broken' otherwise.

    File-existence failure short-circuits — the anchor is not checked when the
    file is missing. Fragments on directories or non-.md targets are out of
    scope and treated as 'ok'.
    """
    if not actual.exists():
        return "broken"
    if not fragment:
        return "ok"
    if not actual.is_file() or actual.suffix.lower() != ".md":
        return "ok"
    return "ok" if fragment in md.heading_slugs(actual) else "broken"


def scan_file(filepath: Path, repo_root: Path, repo_name: str) -> list[dict]:
    """Extract and classify every Link and Citation in one .md file."""
    results = []
    source = str(filepath.relative_to(repo_root))

    def record(target_str: str, line_num: int, actual: Path, fragment: str) -> None:
        results.append(
            {
                "source": source,
                "line": line_num,
                "target": target_str,
                "status": status_of(actual, fragment),
            }
        )

    for line_num, line in md.content_lines(filepath):
        stripped = md.INLINE_CODE_PATTERN.sub("", line)

        # Links and in-link citations: only `/` and `~/workspace` targets that
        # appear inside markdown link syntax.
        for _text, target_str in [
            (m.group(1), m.group(2)) for m in md.MD_LINK_PATTERN.finditer(stripped)
        ]:
            path_str, _, fragment = target_str.partition("#")
            if target_str.startswith("~/workspace/"):
                resolved = Path(path_str.replace("~", str(Path.home()), 1))
                record(
                    target_str,
                    line_num,
                    resolve_citation(resolved, repo_root, repo_name),
                    fragment,
                )
            elif target_str.startswith("/"):
                record(
                    target_str,
                    line_num,
                    repo_root / path_str.lstrip("/"),
                    fragment,
                )

        # Bare citations: `~/workspace/...` outside link syntax. Remove link
        # spans first so an in-link citation is not counted twice.
        remainder = md.MD_LINK_PATTERN.sub("", stripped)
        for match in md.WORKSPACE_REF_PATTERN.finditer(remainder):
            target_str = match.group(0)
            path_str, _, fragment = target_str.partition("#")
            resolved = Path(path_str.replace("~", str(Path.home()), 1))
            record(
                target_str,
                line_num,
                resolve_citation(resolved, repo_root, repo_name),
                fragment,
            )

    return results


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Repository root to scan (default: current directory)",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Emit JSON for every reference, not just broken ones",
    )
    args = parser.parse_args()

    repo_root = Path(args.directory).resolve()
    repo_name = canonical_repo_name(repo_root)

    md_files = source_files(repo_root)
    if not md_files:
        print(f"ref-check: no .md files found in {repo_root}", file=sys.stderr)
        sys.exit(2)

    total = 0
    broken = 0
    for filepath in md_files:
        for ref in scan_file(filepath, repo_root, repo_name):
            total += 1
            if ref["status"] == "broken":
                broken += 1
            if args.all or ref["status"] == "broken":
                print(json.dumps(ref))

    if total == 0:
        print(f"ref-check: no cross-references found in {repo_root}", file=sys.stderr)
        sys.exit(0)
    if broken:
        print(f"ref-check: {broken}/{total} broken", file=sys.stderr)
        sys.exit(1)
    print(f"ref-check: {total} references, all ok", file=sys.stderr)
    sys.exit(0)


if __name__ == "__main__":
    main()
