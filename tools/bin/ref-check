#!/usr/bin/env python3
"""Check cross-references in markdown files.

Scans all .md files for ~/workspace/ paths, resolves them, and reports
broken references as JSON Lines to stdout. Targets may be any file or
directory. Fenced code blocks are skipped. Pass --all to emit every
reference (including ok/external) for agent consumption.

Usage:
    ref-check [--all] [directory]
"""
# /// script
# requires-python = ">=3.11"
# ///

import argparse
import json
import os
import re
import sys
from pathlib import Path

EXCLUDE_DIRS = {
    ".git",
    ".venv",
    ".hatch",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    "__pycache__",
    "node_modules",
}

REF_PATTERN = re.compile(r"~/workspace/[^ )`]+")
FENCE_PATTERN = re.compile(r"^\s*(```|~~~)")


def find_md_files(root: Path) -> list[Path]:
    """Find all .md files under root, excluding ignored directories."""
    results = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in EXCLUDE_DIRS]
        for f in filenames:
            if f.endswith(".md"):
                results.append(Path(dirpath) / f)
    return sorted(results)


def classify_ref(target: Path, repo_root: Path) -> str:
    """Classify a resolved reference as ok, broken, or external."""
    workspace = Path.home() / "workspace"
    rel_to_workspace = target.relative_to(workspace)

    repo_name = repo_root.name
    target_repo = rel_to_workspace.parts[0]

    if target_repo != repo_name:
        return "external"
    actual_path = repo_root / Path(*rel_to_workspace.parts[1:])
    if actual_path.exists():
        return "ok"
    return "broken"


def scan_file(filepath: Path, repo_root: Path) -> list[dict]:
    """Extract and classify all cross-references in a file."""
    results = []
    source = str(filepath.relative_to(repo_root))
    in_fence = False
    with open(filepath) as f:
        for line_num, line in enumerate(f, start=1):
            if FENCE_PATTERN.match(line):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            for match in REF_PATTERN.finditer(line):
                target_str = match.group(0)
                path_str = target_str.split("#", 1)[0]
                resolved = Path(path_str.replace("~", str(Path.home())))
                status = classify_ref(resolved, repo_root)
                results.append(
                    {
                        "source": source,
                        "line": line_num,
                        "target": target_str,
                        "status": status,
                    }
                )
    return results


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Repository root to scan (default: current directory)",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Emit JSON for every reference, not just broken ones",
    )
    args = parser.parse_args()

    repo_root = Path(args.directory).resolve()

    standard = repo_root / "standards" / "repo-documentation.md"
    if not standard.exists():
        print(
            f"ref-check: governing standard not found: {standard}",
            file=sys.stderr,
        )
        sys.exit(2)

    md_files = find_md_files(repo_root)

    if not md_files:
        print(f"ref-check: no .md files found in {repo_root}", file=sys.stderr)
        sys.exit(2)

    has_broken = False
    total = 0
    broken = 0

    for filepath in md_files:
        for ref in scan_file(filepath, repo_root):
            total += 1
            if ref["status"] == "broken":
                has_broken = True
                broken += 1
            if args.all or ref["status"] == "broken":
                print(json.dumps(ref))

    if total == 0:
        print(f"ref-check: no cross-references found in {repo_root}", file=sys.stderr)
    elif has_broken:
        print(f"ref-check: {broken}/{total} broken", file=sys.stderr)
    else:
        print(f"ref-check: {total} references, all ok", file=sys.stderr)

    sys.exit(1 if has_broken else 0)


if __name__ == "__main__":
    main()
