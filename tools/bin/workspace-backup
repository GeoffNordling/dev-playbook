#!/usr/bin/env python3
"""Archive every Git repo in ~/workspace into a single dated .zip.

Each repo is stored as a top-level directory inside the archive, with its
`.git/` folder intact — so a recovered zip is a drop-in replacement for the
original workspace if GitHub is unavailable or credentials are compromised.

Pinned to ~/workspace: no auto-detection, no alternate-path override. If
~/workspace is missing the tool fails loudly rather than silently backing
up the wrong directory.

Usage:
    workspace-backup                  # archive ~/workspace
    workspace-backup -o /tmp/snap.zip # custom output path
    workspace-backup --force          # overwrite existing output
"""

import argparse
import sys
import zipfile
from datetime import datetime
from pathlib import Path


def workspace_dir() -> Path:
    """Return ~/workspace, or fail loudly if it is not a directory.

    The tool is deliberately pinned to ~/workspace — no fallback to other
    locations, no override. A missing workspace is an error, not something
    to silently route around.
    """
    workspace = Path.home() / "workspace"
    if not workspace.is_dir():
        print(
            f"Workspace not found at {workspace} — nothing archived. "
            "This tool only backs up ~/workspace.",
            file=sys.stderr,
        )
        sys.exit(1)
    return workspace


def list_repos(workspace: Path) -> list[Path]:
    """Return sorted git repo paths in a workspace directory."""
    repos = []
    for entry in sorted(workspace.iterdir()):
        if not entry.is_dir():
            continue
        if entry.name.startswith("."):
            continue
        if not (entry / ".git").exists():
            continue
        repos.append(entry)
    return repos


def human_size(num_bytes: float) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if num_bytes < 1024:
            return f"{num_bytes:.1f} {unit}"
        num_bytes /= 1024
    return f"{num_bytes:.1f} PB"


def add_repo(zf: zipfile.ZipFile, repo: Path, workspace: Path) -> int:
    """Add every file under `repo` to `zf`; return bytes written (uncompressed)."""
    total = 0
    for path in repo.rglob("*"):
        if path.is_symlink() or not path.is_file():
            continue
        arcname = path.relative_to(workspace)
        zf.write(path, arcname)
        total += path.stat().st_size
    return total


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help="Output zip path (default: ~/workspace/workspace-backup-YYYY-MM-DD.zip)",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Overwrite the output file if it already exists",
    )
    args = parser.parse_args()

    workspace = workspace_dir()

    output = args.output or (
        workspace / f"workspace-backup-{datetime.now():%Y-%m-%d}.zip"
    )
    if output.exists() and not args.force:
        print(
            f"Output already exists: {output} (use --force to overwrite)",
            file=sys.stderr,
        )
        return 1

    repos = list_repos(workspace)
    if not repos:
        print(f"No Git repos found in {workspace}", file=sys.stderr)
        return 1

    print(f"Archiving {len(repos)} repos -> {output}")
    with zipfile.ZipFile(
        output, "w", compression=zipfile.ZIP_DEFLATED, allowZip64=True
    ) as zf:
        for repo in repos:
            size = add_repo(zf, repo, workspace)
            print(f"  {repo.name:<30} {human_size(size):>10}")

    print(f"\nDone. Archive size: {human_size(output.stat().st_size)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
