#!/usr/bin/env python3
"""Generate validation hook entries in .pre-commit-config.yaml.

Scans tools/bin/ for scripts with `# /// pre-commit` metadata blocks and
generates the local validation hooks section of .pre-commit-config.yaml.
Hand-maintained hooks (ruff, mypy, etc.) are preserved.

Usage:
    generate-pre-commit [directory]
"""
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///

import argparse
import re
import sys
from pathlib import Path

import yaml

START_MARKER = "# --- generated by tools/bin/generate-pre-commit ---"
END_MARKER = "# --- end generated ---"

BLOCK_RE = re.compile(
    r"^# /// pre-commit\s*\n((?:#[^\n]*\n)*?)# ///$",
    re.MULTILINE,
)

# Fields that should be parsed as YAML rather than kept as strings.
YAML_FIELDS = {"pass_filenames", "always_run", "types"}


def parse_pre_commit_block(text: str) -> dict | None:
    """Extract the pre-commit metadata block from a script's text."""
    match = BLOCK_RE.search(text)
    if not match:
        return None

    meta = {}
    for line in match.group(1).splitlines():
        line = line.lstrip("# ").strip()
        if not line or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip('"')

        if key in YAML_FIELDS:
            value = yaml.safe_load(value)

        meta[key] = value

    return meta


def meta_to_hook(meta: dict) -> dict:
    """Convert parsed metadata into a pre-commit hook dict."""
    hook = {
        "id": meta["id"],
        "name": meta["id"],
        "entry": meta["entry"],
        "language": "system",
        "pass_filenames": meta.get("pass_filenames", False),
    }

    if meta.get("always_run"):
        hook["always_run"] = True
    if "types" in meta:
        hook["types"] = meta["types"]
    if "files" in meta:
        hook["files"] = meta["files"]

    return hook


def discover_hooks(bin_dir: Path) -> list[dict]:
    """Scan bin/ for scripts with pre-commit metadata and return hook dicts."""
    hooks = []
    for script in sorted(bin_dir.iterdir()):
        if not script.is_file():
            continue
        try:
            text = script.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        meta = parse_pre_commit_block(text)
        if meta:
            hooks.append(meta_to_hook(meta))
    return hooks


def generate_section(hooks: list[dict]) -> str:
    """Render the generated YAML section as a repos list entry."""
    if not hooks:
        return ""

    lines = [START_MARKER]
    lines.append("  - repo: local")
    lines.append("    hooks:")
    for hook in hooks:
        lines.append(f"      - id: {hook['id']}")
        lines.append(f"        name: {hook['name']}")
        lines.append(f"        entry: {hook['entry']}")
        lines.append(f"        language: {hook['language']}")
        lines.append(f"        pass_filenames: {str(hook['pass_filenames']).lower()}")
        if hook.get("always_run"):
            lines.append("        always_run: true")
        if "types" in hook:
            lines.append(f"        types: {hook['types']}")
        if "files" in hook:
            lines.append(f"        files: {hook['files']}")
    lines.append(END_MARKER)
    return "\n".join(lines) + "\n"


def update_config(config_path: Path, hooks: list[dict]) -> bool:
    """Update the generated section of .pre-commit-config.yaml. Returns True if changed."""
    text = config_path.read_text() if config_path.exists() else ""
    section = generate_section(hooks)

    # Replace existing generated section or append.
    start_idx = text.find(START_MARKER)
    end_idx = text.find(END_MARKER)

    if start_idx != -1 and end_idx != -1:
        end_idx = text.index("\n", end_idx) + 1
        new_text = text[:start_idx] + section + text[end_idx:]
    else:
        # Append after existing content.
        if text and not text.endswith("\n"):
            text += "\n"
        new_text = text + "\n" + section

    if new_text == text:
        return False

    config_path.write_text(new_text)
    return True


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Repository root (default: current directory)",
    )
    args = parser.parse_args()

    repo_root = Path(args.directory).resolve()
    bin_dir = repo_root / "tools" / "bin"
    config_path = repo_root / ".pre-commit-config.yaml"

    if not bin_dir.is_dir():
        print(f"generate-pre-commit: {bin_dir} not found", file=sys.stderr)
        sys.exit(2)

    hooks = discover_hooks(bin_dir)

    if not hooks:
        print(
            "generate-pre-commit: no pre-commit metadata found in tools/bin/",
            file=sys.stderr,
        )
        sys.exit(0)

    changed = update_config(config_path, hooks)

    for hook in hooks:
        print(f"  {hook['id']}")

    if changed:
        print(
            f"generate-pre-commit: wrote {len(hooks)} hook(s) to {config_path.name}",
            file=sys.stderr,
        )
    else:
        print(
            f"generate-pre-commit: {config_path.name} already up to date",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
