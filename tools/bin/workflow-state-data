#!/usr/bin/env python3
"""workflow-state-data — read-only workflow metrics and live issue states.

Thin shim over the workflow_state_data library: parse selectors, fetch
from GitHub, reconstruct records, emit JSON. See that package for the
actual logic and its tests.
"""

