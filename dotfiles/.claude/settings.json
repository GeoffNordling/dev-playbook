{
  "permissions": {
    "allow": [
      "Bash(gh-show:*)"
    ],
    "deny": [
      "EnterWorktree",
      "ExitWorktree"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/geoff/workspace/sounds/play-sound-fedora.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/bell.oga"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/geoff/workspace/dev-playbook/dotfiles/.claude/hooks/ruff-edit.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "theme": "light",
  "voiceEnabled": false
}
