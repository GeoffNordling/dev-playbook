{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/workspace/sounds/play-sound-fedora.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/bell.oga"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/measure-event\"",
            "async": true
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "127.0.0.1"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/workspace",
        "~/.cache",
        "~/.local",
        "~/.npm",
        "~/.agentsview"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc"
      ]
    },
    "excludedCommands": [
      "gh",
      "gh *",
      "agentsview",
      "agentsview *",
      "transcript-export",
      "transcript-export *",
      "*/scripts/transcript-export",
      "*/scripts/transcript-export *",
      "bootstrap-labels",
      "bootstrap-labels *",
      "*/scripts/bootstrap-labels",
      "*/scripts/bootstrap-labels *",
      "workspace-lint",
      "workspace-lint *",
      "*/scripts/workspace-lint",
      "*/scripts/workspace-lint *",
      "git",
      "git *",
      "make check",
      "make check *",
      "uv run pytest",
      "uv run pytest *"
    ]
  }
}
