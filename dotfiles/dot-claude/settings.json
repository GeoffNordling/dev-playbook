{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Skill(tdd)",
      "Skill(build)",
      "Skill(sdd-tdd)",
      "Skill(open-pr)",
      "Skill(sdd-agent-spec-review)",
      "Skill(sdd-agent-code-review)",
      "Skill(agent-code-review)",
      "Skill(code-review)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run mypy *)",
      "Bash(make check)",
      "Bash(make check *)",
      "Bash(pre-commit run *)",
      "Bash(uvx pre-commit run *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(/home/geoff/workspace/dev-playbook/scripts/ref-lint)",
      "Bash(/home/geoff/workspace/dev-playbook/scripts/ref-lint *)",
      "Bash(gh label list)",
      "Bash(gh label list *)",
      "Bash(gh label create *)",
      "Bash(gh issue view *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue lock *)",
      "Bash(gh issue unlock *)",
      "Bash(gh issue transfer *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr update-branch *)",
      "Bash(gh pr lock *)",
      "Bash(gh pr unlock *)"
    ],
    "deny": [
      "AskUserQuestion"
    ]
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/geoff/workspace/dev-playbook/dotfiles/dot-claude/hooks/session-start-sync"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/geoff/workspace/sounds/play-sound-fedora.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/bell.oga"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash /home/geoff/workspace/dev-playbook/dotfiles/dot-claude/statusline.sh"
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "127.0.0.1"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/workspace",
        "~/.cache",
        "~/.local",
        "~/.npm",
        "~/.agentsview"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc"
      ]
    },
    "excludedCommands": [
      "gh",
      "gh *",
      "agentsview",
      "agentsview *",
      "transcript-export",
      "transcript-export *",
      "*/scripts/transcript-export",
      "*/scripts/transcript-export *",
      "bootstrap-labels",
      "bootstrap-labels *",
      "*/scripts/bootstrap-labels",
      "*/scripts/bootstrap-labels *",
      "git",
      "git *",
      "make check",
      "make check *",
      "uv run pytest",
      "uv run pytest *"
    ]
  },
  "feedbackSurveyRate": 0,
  "effortLevel": "xhigh",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "All GitHub CLI (`gh`) operations are approved, including writes such as `gh issue comment`, `gh issue edit` (phase-label changes), `gh issue create`/`close`/`reopen`, `gh pr create`, and `gh pr comment`/`edit`. The software factory's hands-off (auto-mode) nodes use them to post review findings and advance the `phase:*` label on an issue's own GitHub tracker and to open and annotate its PR. These are routine internal project-management writes against our own repositories, not escalations or unrecognized infrastructure."
    ]
  },
  "voiceEnabled": true
}
