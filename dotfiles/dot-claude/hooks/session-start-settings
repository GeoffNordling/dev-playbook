#!/usr/bin/env bash
# SessionStart hook: report Claude Code settings that no longer match source.
#
# ~/.claude/settings.json is generated, not symlinked (see /dotfiles/README.md),
# which gives it a failure mode a symlink has not: pulling a change to the
# source leaves the installed copy stale, and editing the installed copy loses
# the edit at the next sync. Neither is visible without a check.
#
# Informational, not blocking — by the time this runs the session has already
# loaded the stale settings, so the useful act is telling the user to resync.
# Silent on success, and every path exits 0: a non-zero exit would mean "the
# hook broke", never "the check failed".
set -euo pipefail

log="${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/session-start-settings.log"

note() {
	mkdir -p "${log%/*}"
	printf '%s %s\n' "$(date -Is)" "$1" >>"$log"
}

# Stowed into ~/.claude/hooks/, so its own resolved path is what locates the
# checkout — nothing here may assume where the repo was cloned.
self="$(readlink -f "$0")"
checker="${self%/dotfiles/dot-claude/hooks/*}/scripts/sync-dotfiles"

[ -x "$checker" ] || {
	note "skip: no $checker"
	exit 0
}

if drift=$("$checker" --check 2>&1); then
	note "current"
	exit 0
fi

note "DRIFT"
printf 'Tell the user their Claude Code settings need resyncing:\n%s\n' "$drift"
