#!/usr/bin/env python3
"""Claude Code PreToolUse hook: the client-side authority over git.

Reads one PreToolUse event on stdin and either says nothing — the no-opinion
verdict, which falls the call through to the permission rules — or denies.

Two rule families, judged the same way and posted the same way. The **push**
family reads what a push would do and refuses the forbidden spellings; the
**commit** family reads who is asking and refuses every commit but the two
lanes allow. Both walk the same segmentation and the same resolved argv, so a
chained, wrapped or substituted command hides nothing from either.

Python 3 stdlib only, no configuration: a hook runs on every Bash call of every
session, so it may not depend on an interpreter's package set or a knob.
"""

import json
import re
import shlex
import sys
from typing import NamedTuple

# The shell operators the harness itself recognizes as command separators, in
# match order so `&&` is seen before `&`. A rule that read only the first
# command would be evaded by chaining, so each segment is parsed and judged on
# its own.
SEPARATORS = ("&&", "||", ";", "|", "&", "\n")

# A ``git … push`` in text that could not be lexed into argv. Consulted only
# where reading the command properly has already failed — every other rule here
# judges lexed argv, because a command that merely mentions pushing is not a
# push and must not be refused as one.
GIT_PUSH_TEXT = re.compile(r"\bgit\b.*\bpush\b", re.DOTALL)

# The same last resort for ``git … commit``, consulted on the same terms: only
# where a string a wrapper would re-lex could not be lexed. Everywhere else a
# commit is identified by its subcommand token, because "commit" in a path or a
# message is ordinary work.
GIT_COMMIT_TEXT = re.compile(r"\bgit\b.*\bcommit\b", re.DOTALL)

# A shell expansion in a push operand. Whatever remote or refspec it stands for
# is decided when the command runs, so the hook cannot see where the push lands.
EXPANSION = re.compile(r"[$`]")

# Destinations naming whatever ref the checkout happens to sit on, rather than a
# branch. ``HEAD`` from a main checkout writes main, so these are no more
# readable than an expansion.
SYMBOLIC = re.compile(r"(HEAD|@)([~^{@].*)?")

# Wrappers that re-lex a string argument, running a command that never appears
# as argv tokens of its own. Enumerated because looking inside a quoted token is
# only right where something will run it: `printf 'see git push rules'` prints a
# sentence. Every *other* way of putting a push behind another command is caught
# by position instead, which needs no list.
WRAPPERS = frozenset({"bash", "sh", "zsh", "dash", "env", "xargs", "timeout", "eval"})

# A leading environment assignment — `GIT_DIR=x git push …` runs git with the
# variable set, so the command is the token after it, not the assignment.
ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=")

# git's own options, taken before the subcommand, that consume the next token.
GIT_VALUE_OPTIONS = frozenset(
    {
        "-C",
        "-c",
        "--git-dir",
        "--work-tree",
        "--namespace",
        "--exec-path",
        "--config-env",
    }
)

# git push options that consume the next token.
PUSH_VALUE_OPTIONS = frozenset(
    {"-o", "--push-option", "--receive-pack", "--exec", "--repo"}
)

# Every option spelling that forces. --force-with-lease is here with the rest by
# ruling: it is safer than --force and still rewrites published history.
FORCE_FLAGS = frozenset({"-f", "--force", "--force-with-lease", "--force-if-includes"})

# Every option spelling that deletes a remote ref. The empty-source refspec
# (``:branch``) deletes too, and is caught on the operands rather than here.
DELETE_FLAGS = frozenset({"-d", "--delete"})

# The one reason covering every push the hook cannot read. Failing closed is the
# whole posture: none of these can be cleared, which is also why no rule here
# has an override marker — the escape hatch is the human's own terminal.
UNREADABLE = (
    "This hook reads every push before it runs, and it cannot read this one — "
    "it is wrapped, substituted, or will not lex. Write the push out as a "
    "plain, top-level command."
)

# The factory families that commit, named by the frontmatter ``name`` of the
# agent definition a subagent is spawned as. The harness writes the value into
# the payload, so no prompt, brief or skill can claim membership; adding one
# here is adding a committing family to the factory.
ALLOWED_AGENT_TYPES = frozenset({"builder", "judgment-facilitator"})

# The harness-written marker a typed slash command leaves in the transcript.
# Assembled from pieces, never spelled whole: a file carrying it could be
# pasted into a user turn and read here as a grant nobody typed — which is also
# why no authored file in the workspace may contain it. The leading slash is
# optional because the harness has been seen writing the name both ways.
MARKER_OPEN = "<command-" + "name>"
MARKER_CLOSE = "</command-" + "name>"
MARKER = re.compile(MARKER_OPEN + r"/?commit-(on|off)" + MARKER_CLOSE)

# The commit family's two denials, one per lane. Each reaches the model
# verbatim, so each names what would open the lane and who opens it — never a
# spelling to try instead.
#
# The lane-1 denial names the agent type it read and stops there. Why a session
# carries that type is not something this hook can see, and a reader told
# "you are a subagent" by a hook that cannot verify it is left with a diagnosis
# instead of a fact; the value is the fact, and it is what makes the refusal
# reportable.
NOT_A_COMMITTING_TYPE = (
    "git commit is denied: this session is judged by its agent type, which is "
    "{agent_type!r}, and only the factory's committing types commit — builder, "
    "judgment-facilitator. A typed /commit-on grant is read only for a session "
    "carrying no agent type at all, so it cannot open this lane. Report the "
    "refusal with the type named above; do not re-spell the command."
)

NO_GRANT = (
    "git commit is denied unless this session holds a live grant, and it holds "
    "none. The user types /commit-on to give one and /commit-off to revoke it. "
    "Ask for the grant, or hand the commit to the user; do not re-spell this."
)

# What a fault in this hook's own machinery says, where the hook had authority
# over the command. Failing closed is the ruling: a bug here blocks the push or
# the commit loudly instead of waving it through unjudged, and the fault is
# named so the hook gets fixed rather than worked around.
INTERNAL = (
    "The git-authority hook could not judge this command and denied it rather "
    "than let it run unjudged — {fault}. Report this: the hook needs repair, "
    "and the command is not to be re-spelled meanwhile."
)


class Command(NamedTuple):
    """One command the shell will run, and how the hook reached it.

    ``substituted`` marks a command found inside a ``$(…)`` or backtick body.
    It runs like any other, but its output is swallowed by the command around
    it, so a push there is judged differently — see ``verdict``.

    ``argv`` is the command lexed once, at construction, and None where the text
    will not lex at all. Both families read it, and a hook that runs on every
    Bash call of every session has no business lexing the same line twice.
    """

    text: str
    substituted: bool
    argv: list[str] | None


def deny(reason: str) -> None:
    """Print the deny decision and exit.

    The reason reaches the model verbatim, so it names the ruling rather than
    the mechanism: a denied operation is refused, never re-spelled.
    """
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            }
        )
    )
    sys.exit(0)


def segments(command: str) -> list[str]:
    """The command's shell segments — what the harness matches independently.

    Split on unquoted operators only, and only where they really separate
    commands. A ``;`` inside ``git commit -m "push; done"`` separates nothing,
    and a split blind to structure does damage in both directions: it fractures
    ordinary commands into pieces that will not lex, and it hides a real push
    behind them. Three structures are therefore tracked:

    - **Quotes.** Their contents are one token, operators included.
    - **Command substitutions**, ``$(…)`` and backtick pairs. A separator inside
      one belongs to the substitution; splitting there would leave the body
      unbalanced, and the push in it unseen. The body is judged separately.
    - **Subshell grouping**, ``(…)``. Here the parentheses *are* boundaries:
      ``(git push origin main)`` runs a push as its own command, and a splitter
      that kept the paren attached would read the command as ``(git``.
    """
    found: list[str] = []
    current: list[str] = []
    quote = ""
    depth = 0
    backtick = False
    index = 0
    while index < len(command):
        char = command[index]
        if char == "\\" and quote != "'" and index + 1 < len(command):
            current.append(command[index : index + 2])
            index += 2
            continue
        if quote:
            current.append(char)
            if char == quote:
                quote = ""
            index += 1
            continue
        if char in "'\"":
            quote = char
            current.append(char)
            index += 1
            continue
        if char == "`":
            backtick = not backtick
            current.append(char)
            index += 1
            continue
        if command.startswith("$(", index):
            depth += 1
            current.append("$(")
            index += 2
            continue
        if depth and char == ")":
            depth -= 1
            current.append(char)
            index += 1
            continue
        if backtick or depth:
            current.append(char)
            index += 1
            continue
        separator = next((s for s in SEPARATORS if command.startswith(s, index)), None)
        if separator is None and char in "()":
            separator = char
        if separator is not None:
            found.append("".join(current))
            current = []
            index += len(separator)
            continue
        current.append(char)
        index += 1
    found.append("".join(current))
    return [part.strip() for part in found if part.strip()]


def balanced(text: str, start: int, opener: str | None, closer: str) -> tuple[str, int]:
    """The substitution body opening at ``start``, and the index past its closer.

    Nesting is counted, so ``$(a $(b) c)`` yields the whole outer body rather
    than stopping at the first ``)``. An unclosed substitution yields the rest
    of the text: reading too much is the failing-closed direction, because what
    is read is then judged.
    """
    depth = 1
    quote = ""
    index = start
    while index < len(text):
        char = text[index]
        if char == "\\" and quote != "'" and index + 1 < len(text):
            index += 2
            continue
        if quote:
            if char == quote:
                quote = ""
            index += 1
            continue
        if char in "'\"":
            quote = char
            index += 1
            continue
        if opener is not None and char == opener:
            depth += 1
        elif char == closer:
            depth -= 1
            if depth == 0:
                return text[start:index], index + 1
        index += 1
    return text[start:], len(text)


def substitutions(text: str) -> list[str]:
    """The body of every command substitution in ``text``.

    ``$(…)`` and a backtick pair each run a command whose argv never appears in
    the enclosing one, so the body is pulled out to be read on its own. Single
    quotes make both inert; double quotes do not, which is why the walk below
    keeps looking inside a ``"…"`` run.
    """
    found: list[str] = []
    quote = ""
    index = 0
    while index < len(text):
        char = text[index]
        if char == "\\" and quote != "'" and index + 1 < len(text):
            index += 2
            continue
        if quote == "'":
            quote = "" if char == "'" else quote
            index += 1
            continue
        if quote == '"' and char == '"':
            quote = ""
            index += 1
            continue
        if not quote and char in "'\"":
            quote = char
            index += 1
            continue
        if text.startswith("$(", index):
            body, index = balanced(text, index + 2, "(", ")")
            found.append(body)
            continue
        if char == "`":
            body, index = balanced(text, index + 1, None, "`")
            found.append(body)
            continue
        index += 1
    return found


def lex(text: str) -> list[str] | None:
    """``text`` as the argv it runs, or None where it will not lex.

    Comments are not stripped, and a heredoc body is read like any other line:
    both are text the shell would never run, and both are refused where they
    name a git verb. That false deny is accepted by ruling. Reading those two
    shapes the way bash reads them took a parser that disagreed with bash
    somewhere else, and every disagreement so far was a fail-open — the worse
    failure in a hook whose whole posture is to fail closed. The Guide records
    the trade; #355 replaces this lexing wholesale.
    """
    try:
        return command_argv(shlex.split(text))
    except ValueError:
        return None


def commands(text: str, substituted: bool = False) -> list[Command]:
    """Every command ``text`` runs — its own segments, and every substituted one.

    Flattening the whole line first is what makes chaining, grouping and
    substitution all one problem: each command is then judged on its own, and
    none of them can hide behind the shape of another.
    """
    found: list[Command] = []
    for segment in segments(text):
        found.append(Command(segment, substituted, lex(segment)))
        for body in substitutions(segment):
            found.extend(commands(body, substituted=True))
    return found


def command_argv(argv: list[str]) -> list[str]:
    """``argv`` reduced to the command it actually runs, and that command's name.

    A leading run of environment assignments belongs to the shell, not the
    command, and a command named by path is the same command: ``GIT_DIR=x git``
    and ``/usr/bin/git`` both run git, and a rule reading argv[0] literally
    would let either write main unjudged.
    """
    index = 0
    while index < len(argv) and ASSIGNMENT.match(argv[index]):
        index += 1
    rest = argv[index:]
    if not rest:
        return rest
    return [rest[0].rpartition("/")[2], *rest[1:]]


def subcommand_argv(argv: list[str], subcommand: str) -> list[str] | None:
    """``argv``'s arguments after ``subcommand``, or None if it runs another one.

    The one place a git subcommand is identified. It is read off the resolved
    argv rather than matched in the text, because a path, a message or another
    command's output may carry the word: only the token git itself would take
    as the subcommand makes the command one. git's own options come first and
    some consume the token after them, so they are walked past, not skipped by
    count.
    """
    argv = command_argv(argv)
    if not argv or argv[0] != "git":
        return None
    index = 1
    while index < len(argv) and argv[index].startswith("-"):
        index += 2 if argv[index] in GIT_VALUE_OPTIONS else 1
    if index >= len(argv) or argv[index] != subcommand:
        return None
    return argv[index + 1 :]


def reaches(argv: list[str], subcommand: str, mention: re.Pattern[str]) -> bool:
    """Whether ``subcommand`` sits in ``argv`` somewhere this hook cannot judge it.

    A git subcommand behind another command still runs — ``sudo git push …``,
    ``nohup git commit …``, ``timeout 5 git push …`` — but not as the command
    the segment names, so the hook cannot hold the whole call to account and
    reads it as reaching the subcommand anyway. A wrapper hides one further
    still, inside a string it re-lexes; ``mention`` is the text form consulted
    only where that string will not lex.
    """
    if any(
        subcommand_argv(argv[start:], subcommand) is not None
        for start in range(1, len(argv))
    ):
        return True
    if not argv or argv[0] not in WRAPPERS:
        return False
    for token in argv:
        if " " not in token:
            continue
        try:
            inner = shlex.split(token)
        except ValueError:
            if mention.search(token):
                return True
            continue
        if any(
            subcommand_argv(inner[start:], subcommand) is not None
            for start in range(len(inner))
        ):
            return True
    return False


def reaches_push(argv: list[str]) -> bool:
    """Whether a push sits in ``argv`` somewhere this hook cannot judge it."""
    return reaches(argv, "push", GIT_PUSH_TEXT)


def reaches_commit(argv: list[str]) -> bool:
    """Whether a commit sits in ``argv`` somewhere this hook cannot judge it."""
    return reaches(argv, "commit", GIT_COMMIT_TEXT)


def flags(argv: list[str]) -> set[str]:
    """Every option token in ``argv``, with short bundles split into letters.

    ``-fu`` is git's own spelling of ``-f -u``, so a rule reading tokens alone
    would miss a forced push written that way.
    """
    found: set[str] = set()
    for token in argv:
        if not token.startswith("-") or token == "-":
            continue
        if token.startswith("--"):
            found.add(token.split("=", 1)[0])
        elif re.fullmatch(r"-[A-Za-z]+", token):
            found.update(f"-{letter}" for letter in token[1:])
        else:
            found.add(token)
    return found


def operands(argv: list[str]) -> list[str]:
    """The non-option arguments of a push — the remote, then its refspecs."""
    found: list[str] = []
    skip = False
    for token in argv:
        if skip:
            skip = False
            continue
        if token.startswith("-") and token != "-":
            if token in PUSH_VALUE_OPTIONS:
                skip = True
            continue
        found.append(token)
    return found


def destination(refspec: str) -> str:
    """The branch a refspec writes to, normalized to a bare short name.

    ``main``, ``HEAD:main``, ``issue-9:refs/heads/main`` and ``+HEAD:main`` all
    write to main; each carries the destination on the right of the colon, or
    is the destination entire when there is no colon.

    A destination not starting with ``refs/`` is resolved by git against the
    remote's existing refs, so the partial form ``heads/main`` names
    ``refs/heads/main`` too. Only the branch namespace is stripped: a
    ``refs/tags/main`` destination writes a tag, not the branch.
    """
    target = refspec.removeprefix("+")
    _, colon, right = target.partition(":")
    if colon:
        target = right
    if target.startswith("refs/heads/"):
        return target.removeprefix("refs/heads/")
    return target.removeprefix("heads/")


def judge(argv: list[str]) -> str | None:
    """The ruling one push's argv breaks, or None when it breaks none."""
    found = operands(argv)
    if len(found) < 2:
        return (
            "git push must name both a remote and a refspec — a push whose "
            "target is implied is invisible state. Write it out in full."
        )
    refspecs = found[1:]
    written = flags(argv)
    if any(EXPANSION.search(operand) for operand in found):
        return (
            "This hook reads where a push would land before it runs, and a "
            "shell expansion settles that only once the command runs. Write "
            "the remote and the branch out as literal text."
        )
    if any(destination(refspec) == "main" for refspec in refspecs):
        return (
            "main is written by merging a pull request, never by pushing to "
            "it. Open a PR from this branch instead."
        )
    if written & FORCE_FLAGS or any(refspec.startswith("+") for refspec in refspecs):
        return (
            "A forced push rewrites published history, including with "
            "--force-with-lease. There is no agent lane for it: discuss the "
            "repair with the top-level session, and the human types it in "
            "their own terminal."
        )
    if written & DELETE_FLAGS or any(refspec.startswith(":") for refspec in refspecs):
        return (
            "The only remote-branch deletion is GitHub's delete-on-merge. "
            "Leave the branch alone."
        )
    if any(SYMBOLIC.fullmatch(destination(refspec)) for refspec in refspecs):
        return (
            "HEAD is whatever branch the checkout is standing on, which on a "
            "main checkout is main. Name the branch the push writes: "
            "git push origin issue-9, or the HEAD:issue-9 form."
        )
    return None


def verdict(command: Command) -> str | None:
    """The ruling ``command`` breaks, or None when it breaks none.

    A command that will not lex is one this hook cannot read, and it is refused
    only where its text resolves to a git push: an ordinary command carrying the
    word "push" is not a push, and denying it would stop work this hook has no
    authority over.

    A push inside a substitution is never judged on its merits. Its output is
    consumed by the enclosing command rather than reported, so even a routine
    spelling there is a push nobody watched, and it fails closed with the rest.
    The commit family draws the opposite conclusion from the same shape, by
    ruling — see the Guide.
    """
    if command.argv is None:
        return UNREADABLE if GIT_PUSH_TEXT.search(command.text) else None
    after = subcommand_argv(command.argv, "push")
    if after is None:
        return UNREADABLE if reaches_push(command.argv) else None
    return UNREADABLE if command.substituted else judge(after)


def commits(command: Command) -> bool:
    """Whether ``command`` runs a git commit, in any spelling the hook can reach.

    The same reading the push family gets, and the same failing-closed
    direction: a segment that will not lex counts as a commit where its text
    resolves to a ``git … commit``, and one reachable only behind a wrapper or
    a position counts too. What the hook cannot read, it does not wave through
    — the lanes below still decide whether it runs.
    """
    if command.argv is None:
        return bool(GIT_COMMIT_TEXT.search(command.text))
    if subcommand_argv(command.argv, "commit") is not None:
        return True
    return reaches_commit(command.argv)


def user_texts(transcript_path: str) -> list[str]:
    """The text of every genuine user turn in the transcript, in order.

    Genuine is the whole point: a marker only counts where the harness wrote it
    because the user typed the command. An assistant turn, and a user-role turn
    carrying a ``tool_result``, are both text the model put there — a file it
    read, a command's output — so neither is read for markers at all. A line
    that will not parse is skipped: a transcript is appended to live, and its
    last line may be half-written when the hook reads it.
    """
    found: list[str] = []
    with open(transcript_path, encoding="utf-8", errors="replace") as transcript:
        for line in transcript:
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            if not isinstance(entry, dict) or entry.get("type") != "user":
                continue
            message = entry.get("message")
            content = message.get("content") if isinstance(message, dict) else None
            if isinstance(content, str):
                found.append(content)
                continue
            if not isinstance(content, list):
                continue
            if any(
                isinstance(block, dict) and block.get("type") == "tool_result"
                for block in content
            ):
                continue
            found.extend(
                str(block.get("text", ""))
                for block in content
                if isinstance(block, dict) and block.get("type") == "text"
            )
    return found


def granted(transcript_path: str) -> bool:
    """Whether the session's last typed marker was the grant, not the revocation.

    Later wins, so a grant survives everything before it and nothing after it:
    the user turns /commit-on and /commit-off as often as they like, and the
    hook reads the one they typed last.

    A transcript that will not open holds no grant this hook can see, which is
    the ungranted state and not a fault in the hook. Letting the error escape
    would report a defect in working machinery and send the reader to repair it,
    instead of to the one thing that opens the lane — typing the grant.
    """
    try:
        texts = user_texts(transcript_path)
    except OSError:
        return False
    verdicts = [match.group(1) for text in texts for match in MARKER.finditer(text)]
    return bool(verdicts) and verdicts[-1] == "on"


def lane(event: dict) -> str | None:
    """The reason this session may not commit, or None when a lane opens.

    The two lanes are disjoint by spawn context, and that exclusivity is what
    keeps a grant out of reach of anything that did not type it. A subagent
    writes a transcript of its own, and the first user turn in it is the launch
    prompt its parent model wrote — so a subagent judged by lane 2 would read
    one model's prompt to another as a grant, minting its own authorization on
    the way in. A payload carrying ``agent_type`` is a subagent, judged by the
    allowlist alone, whatever its transcript holds.
    """
    if "agent_type" in event:
        agent_type = event.get("agent_type")
        if agent_type in ALLOWED_AGENT_TYPES:
            return None
        return NOT_A_COMMITTING_TYPE.format(agent_type=agent_type)
    transcript_path = event.get("transcript_path")
    if not isinstance(transcript_path, str) or not transcript_path:
        return NO_GRANT
    return None if granted(transcript_path) else NO_GRANT


def command_text(event: object) -> str:
    """The Bash command an event names, or the empty string where it names none.

    Every shape that is not a Bash command line reads as no command at all,
    because this hook rules on nothing else — and because the fault handler
    below asks the same question of an event that has already gone wrong.
    """
    if not isinstance(event, dict) or event.get("tool_name") != "Bash":
        return ""
    tool_input = event.get("tool_input")
    if not isinstance(tool_input, dict):
        return ""
    line = tool_input.get("command")
    return line if isinstance(line, str) else ""


def evaluate(event: object) -> None:
    """Print the verdict on one PreToolUse event, if there is one.

    An event naming no Bash command is nothing this hook rules on and draws no
    opinion; everything past that point is judged.
    """
    if not isinstance(event, dict):
        return
    line = command_text(event)
    if not line:
        return
    found = commands(line)
    for command in found:
        reason = verdict(command)
        if reason is not None:
            deny(reason)
    if any(commits(command) for command in found):
        reason = lane(event)
        if reason is not None:
            deny(reason)


def main() -> None:
    """Read the event off stdin and judge it, failing closed where it rules.

    The trap covers the whole path, an unparseable event included: everything
    that can go wrong in here is this hook's own doing, and a hook that cannot
    reach a verdict has not cleared the command — it has failed to judge it.
    ``deny`` leaves through SystemExit, so a denial is not caught here.

    Failing closed is bounded by authority, though. This hook runs on *every*
    Bash call of every session, and a fault denying them all would take out
    ``ls`` and ``make check`` everywhere at once over a command it was never
    going to rule on. So a fault denies only where the command reads as a push
    or a commit — ``command_text`` below, tested against the same two text
    patterns the readable path falls back on. The faults that cannot be scoped
    that way are the ones parsing never survives: stdin that arrived and will
    not parse, and the rarer read that itself faults — undecodable bytes on
    the pipe. Either way there is no command to read and ``event`` is still
    None, so both fail closed whole: what arrives corrupted is denied, not
    guessed at.

    Stdin that is empty or blank is not that fault. It carries no event at all,
    which is the shape a closed or truncated pipe takes, and nothing in it says
    a git verb was ever involved — so it draws no opinion rather than denying
    every Bash call on the machine at once. What arrives and will not parse is
    still denied whole.
    """
    event: object = None
    try:
        arriving = sys.stdin.read()
        if not arriving.strip():
            return
        event = json.loads(arriving)
        evaluate(event)
    except Exception as fault:
        # The coarsest possible reading of the command, asked in this one place:
        # was the fault over something this hook had any authority over? Reading
        # too much is the failing-closed direction, since a false match denies a
        # push or a commit that was never judged, while a false miss waves one
        # through.
        text = command_text(event)
        if event is None or GIT_PUSH_TEXT.search(text) or GIT_COMMIT_TEXT.search(text):
            deny(INTERNAL.format(fault=f"{type(fault).__name__}: {fault}"))


if __name__ == "__main__":
    main()
