#!/usr/bin/env bash
# SessionStart hook: refuse to open a session on a stale main.
#
# Multi-machine repos go stale silently — main moves on the other machine and
# nothing here says so until work has already landed on the old base. This
# checks, at every session start, whether GitHub's main holds commits the local
# main ref does not. Worktrees share that ref, so the answer is the same from
# anywhere in the repo and every session gets told.
#
# Silent on success. stdout is the only signal reaching the agent, and every
# path exits 0: a non-zero exit means "the hook broke", never "the check
# failed". An in-sync repo therefore costs the agent no context at all.
#
# The check is read-only over HTTPS with gh's keyring PAT. It deliberately does
# not pull: a SessionStart hook runs before the agent has read anything, and
# moving the checkout out from under a session that has not started is worse
# than telling it to pull. The instruction below is the whole remedy.
#
# Every run appends one line to the log below. A hook that is silent by design
# has no other way to show it is alive, and the logged `source` is the only
# evidence of which SessionStart reasons actually reach it.
set -euo pipefail

log="${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/session-start-stale-base.log"

# The harness pipes a JSON payload in; a hand-run from a terminal has no stdin
# and must not block waiting for one.
source_event=unknown
if [ ! -t 0 ]; then
	source_event=$(cat | jq -r '.source // "unknown"' 2>/dev/null) || source_event=unknown
fi

note() {
	mkdir -p "${log%/*}"
	printf '%s source=%-8s %-24s %s\n' \
		"$(date -Is)" "$source_event" "${PWD##*/}" "$1" >>"$log"
}

cd "${CLAUDE_PROJECT_DIR:-$PWD}"

# Not applicable → silent. A non-git directory fails the remote lookup too, so
# these two guards cover every case where there is nothing to compare.
git remote get-url origin 2>/dev/null | grep -q github.com || {
	note "skip: no github remote"
	exit 0
}
git rev-parse --verify --quiet main >/dev/null || {
	note "skip: no local main"
	exit 0
}

# The remedy has to run where main is checked out. `git pull --ff-only origin
# main` moves the ref this check reads only from main: run anywhere else it
# merges origin/main into whatever branch is out, which fails the moment that
# branch holds a commit and leaves local main — and so the next session's
# verdict — untouched. `--git-common-dir` names the main checkout's .git from
# anywhere in the repo, worktrees included, so its parent is the directory the
# pull is prescribed against. Worktrees share the ref it moves, which is what
# lets a worktree session clear this without leaving its own branch.
main_checkout=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
main_checkout_branch=$(git -C "$main_checkout" branch --show-current)
main_checkout_branch=${main_checkout_branch:-a detached HEAD}

# Hooks are harness subprocesses, not Bash-tool calls: there is no bwrap jail
# here, so wrapping gh in `timeout` is safe and keeps an offline machine from
# stalling session start. Do not "fix" this into a bare top-level gh call.
remote_sha=$(timeout 5 gh api "repos/{owner}/{repo}/branches/main" --jq .commit.sha 2>/dev/null) || {
	note "unverified: gh call failed"
	echo "Could not reach GitHub to check whether main is current (gh call failed). Treat the base as unverified."
	exit 0
}

# Containment, not equality. Local main being *ahead* of GitHub is the normal
# state after any local commit, and equality would report it as stale — a false
# alarm on most sessions. Ask instead whether GitHub's tip is already in local
# history: yes covers both level and ahead, no covers both behind and diverged.
if git merge-base --is-ancestor "$remote_sha" main 2>/dev/null; then
	note "fresh"
	exit 0
fi

note "STALE: github at $remote_sha"
cat <<EOF
STOP — stale base. Do not answer the user's request yet.
GitHub's main ($remote_sha) holds commits this checkout does not.
EOF

if [ "$main_checkout_branch" = "main" ]; then
	cat <<EOF
Before anything else, bring main current:
    git -C $main_checkout pull --ff-only origin main
Every worktree of this repo shares the ref that moves, so this one command
clears the check for this session too, wherever it is standing. Do not read,
edit, commit, or branch until it succeeds. If it cannot fast-forward, main has
diverged — say so and stop; do not force it.
EOF
else
	cat <<EOF
Main cannot be refreshed from here: its checkout ($main_checkout) is standing
on $main_checkout_branch, and the pull that moves main only moves it from main.
Tell the user, and stop. Do not read, edit, commit, or branch, and do not pull
into the branch that is out instead — that merges origin/main into it and
leaves main stale.
EOF
fi
