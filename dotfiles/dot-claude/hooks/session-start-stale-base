#!/usr/bin/env bash
# SessionStart hook: warn when this checkout's main is behind GitHub's.
#
# Multi-machine repos go stale silently — main moves on the other machine and
# nothing here says so until work has already landed on the old base.
#
# Detect, escalate, stop. This prescribes no remedy and never pulls: it fires
# before the agent has read anything, so the only safe move is to hand the
# problem to the user. Do not grow a fix-it path in here.
#
# Silent on success, and every path exits 0 — a non-zero exit means the hook
# broke, never that the check failed. An in-sync repo costs the agent nothing.
#
# Every run appends one line to the log below, including the SessionStart
# `source`. It is the only evidence a silent-by-design hook is alive.
set -euo pipefail

log="${XDG_CACHE_HOME:-$HOME/.cache}/claude-code/session-start-stale-base.log"

# The harness pipes JSON in; a hand-run from a terminal has no stdin and must
# not block waiting for one.
source_event=unknown
if [ ! -t 0 ]; then
	source_event=$(cat | jq -r '.source // "unknown"' 2>/dev/null) || source_event=unknown
fi

note() {
	mkdir -p "${log%/*}"
	printf '%s source=%-8s %-24s %s\n' \
		"$(date -Is)" "$source_event" "${PWD##*/}" "$1" >>"$log"
}

cd "${CLAUDE_PROJECT_DIR:-$PWD}"

# Not applicable → silent. A non-git directory fails the remote lookup too, so
# these two guards cover every case where there is nothing to compare.
git remote get-url origin 2>/dev/null | grep -q github.com || {
	note "skip: no github remote"
	exit 0
}
git rev-parse --verify --quiet main >/dev/null || {
	note "skip: no local main"
	exit 0
}

# No bwrap jail in a hook, so wrapping gh in `timeout` is safe — and it stops an
# offline machine stalling session start. Do not "fix" this to a bare gh call.
remote_sha=$(timeout 5 gh api "repos/{owner}/{repo}/branches/main" --jq .commit.sha 2>/dev/null) || {
	note "unverified: gh call failed"
	echo "Could not reach GitHub to check whether main is current. Treat the base as unverified."
	exit 0
}

# Containment, not equality: local main being *ahead* is normal after a local
# commit, and equality would flag that as stale. Is GitHub's tip already in
# local history? Yes = level or ahead (fresh); no = behind or diverged (stale).
if git merge-base --is-ancestor "$remote_sha" main 2>/dev/null; then
	note "fresh"
	exit 0
fi

note "STALE: github at $remote_sha"

# The tree's state shapes the user's decision, so report it here.
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
	tree_state="The working tree has uncommitted changes."
else
	tree_state="The working tree is clean."
fi

cat <<EOF
STOP — stale base. Do not answer the user's request yet.
GitHub's main ($remote_sha) holds commits this checkout does not.
$tree_state
Tell the user, and ask what they want to do. Decide nothing yourself: do not
pull, read, edit, commit, or branch until they answer.
EOF
