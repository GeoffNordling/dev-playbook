#!/usr/bin/env python3
"""Claude Code hook: append one hook event, raw and verbatim, to this machine's store.

Wired async in dotfiles/dot-claude/settings.json, so capture never sits in a
session's critical path. That settings file is shared by every machine, so
every machine invokes this hook — but the store lives on the Fedora primary
alone, so anywhere else the guard in main() exits without recording. The
harness pipes the event JSON in on stdin; this appends one row and exits.

Inside a sandboxed run there is no store to append to — the container's own
filesystem is thrown away with the container — so the row is handed to a
receiver on the host instead. record() takes that path when the sink file
exists, and nothing else in this hook changes.

Storage is append-only and uninterpreted: no parsing for meaning, filtering,
or deduplication at write time — a row dropped here is one no future query
can ask for. The one exception is mechanical rather than interpretive: a
PostToolUse for a tool other than Bash has `tool_input` and `tool_response`
dropped unread, storing the envelope alone (#255, ruling 23).

Failure discipline — the one sanctioned exception to this workspace's
fail-loud rule: a session must never fail because measurement did. Every path
exits 0; a failure to record appends a line to errors.log beside the database,
and a failure to write even that is swallowed. The gap in the data is the
loud signal, raised at report time.

Python 3 stdlib only, no configuration: a hook runs on every event of every
session, so it may not depend on an interpreter's package set or a knob.
"""

import json
import socket
import sqlite3
import sys
from datetime import UTC, datetime
from pathlib import Path

STORE = Path("~/.local/share/claude-measure").expanduser()
DB_PATH = STORE / "events.db"
ERROR_LOG = STORE / "errors.log"

# Written by the launcher of a sandboxed run and mounted read-only, carrying
# one line: `<address> <port>` of a receiver listening on the host. Its
# presence is how this hook detects that it is inside a container with no real
# store to write — the same self-detection idea as on_fedora(), not a knob.
SINK_PATH = STORE / "sink"

# The cap on every socket call to that receiver. Far more than the millisecond
# a loopback hop takes, and still a hard bound: a session must never wait on
# measurement, so on expiry the event is dropped rather than retried.
SINK_TIMEOUT_SECONDS = 10.0

# Concurrent sessions write to one database. WAL lets their readers and this
# writer coexist, and the busy timeout makes a collision queue rather than
# fail — long enough to outlast any contention a hook insert can create, short
# enough that a genuinely stuck database gives up while the session is young.
BUSY_TIMEOUT_SECONDS = 5.0

SCHEMA = """
CREATE TABLE IF NOT EXISTS events (
    id INTEGER PRIMARY KEY,
    received_at TEXT,
    event TEXT,
    session_id TEXT,
    prompt_id TEXT,
    payload TEXT
)
"""

INSERT = """
INSERT INTO events (received_at, event, session_id, prompt_id, payload)
VALUES (?, ?, ?, ?, ?)
"""

# The payload keys that get their own column. Every other key stays in the
# payload text and nowhere else.
PROMOTED = ("hook_event_name", "session_id", "prompt_id")

# The payload keys a non-Bash tool use loses before storage. Deleted by name,
# never inspected: the trim is a fixed rule about which tool, not a judgment
# about what the content was worth.
TRIMMED = ("tool_input", "tool_response")


def promoted_values(payload: str) -> tuple[str | None, ...]:
    """The promoted columns read out of one payload; NULL for whatever is absent.

    A payload that is not a JSON object — malformed stdin, or valid JSON that
    is a list or a bare string — promotes nothing. The row still lands, because
    the text of an event nobody can parse is the only evidence that it arrived.
    """
    try:
        parsed = json.loads(payload)
    except ValueError:
        return (None,) * len(PROMOTED)
    if not isinstance(parsed, dict):
        return (None,) * len(PROMOTED)
    values = []
    for key in PROMOTED:
        value = parsed.get(key)
        # Promoted columns are TEXT. A payload whose session_id arrived as a
        # number or an object is still recorded whole; only the column is NULL.
        values.append(value if isinstance(value, str) else None)
    return tuple(values)


def for_storage(payload: str) -> str:
    """One payload as it is stored: the text that arrived, bar one trim.

    A `PostToolUse` naming a tool other than Bash stores its envelope —
    `tool_name`, `duration_ms`, and the rest — re-serialized without
    `tool_input` and `tool_response`, because no query needs a Read's file text
    or an Edit's diff (#255, ruling 23). Bash keeps its content: the factory's
    standardized commands are what future queries read.

    Everything this cannot positively identify as a non-Bash tool use is
    returned untouched, including stdin that does not parse and a `PostToolUse`
    with no string `tool_name` — a payload that cannot be classified is the one
    most worth keeping whole.
    """
    try:
        parsed = json.loads(payload)
    except ValueError:
        return payload
    if not isinstance(parsed, dict) or parsed.get("hook_event_name") != "PostToolUse":
        return payload
    tool_name = parsed.get("tool_name")
    if not isinstance(tool_name, str) or tool_name == "Bash":
        return payload
    return json.dumps({k: v for k, v in parsed.items() if k not in TRIMMED})


def row_values(received_at: str, payload: str) -> tuple[str | None, ...]:
    """One event as the row it becomes, in INSERT's column order.

    Both destinations below send exactly this, so a column added to INSERT is
    added to the sandboxed path in the same edit.
    """
    return (received_at, *promoted_values(payload), payload)


def send_to_sink(row: tuple[str | None, ...]) -> None:
    """Hand one row to the receiver the sink file names, over its own connection.

    Used only inside a sandboxed run, where DB_PATH would be a database in the
    container's own filesystem, thrown away with the container. The receiver is
    the host process that started the run; it does the insert into the real
    store, as the user.

    The row goes as one JSON list and the write half is then closed, so the
    length of the message is the connection itself — nothing to frame and
    nothing to parse incrementally.
    """
    address, port = SINK_PATH.read_text().split()
    with socket.create_connection(
        (address, int(port)), timeout=SINK_TIMEOUT_SECONDS
    ) as sock:
        sock.sendall(json.dumps(row).encode("utf-8"))
        sock.shutdown(socket.SHUT_WR)


def record(received_at: str, payload: str) -> None:
    """Append one row, creating the store, the database, and the table as needed.

    A sandboxed run is the exception: there the sink file exists, and the row
    is sent to the host receiver instead of written here.
    """
    if SINK_PATH.exists():
        send_to_sink(row_values(received_at, payload))
        return

    STORE.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(DB_PATH, timeout=BUSY_TIMEOUT_SECONDS)
    try:
        # Persistent, so only the first write of the database's life changes
        # anything; the rest read back the mode they already have.
        connection.execute("PRAGMA journal_mode=WAL")
        connection.execute(SCHEMA)
        connection.execute(INSERT, row_values(received_at, payload))
        connection.commit()
    finally:
        connection.close()


def note_failure(received_at: str, error: BaseException) -> None:
    """Append one line about an event that could not be recorded.

    Best effort by construction: the reasons a row cannot be written — the
    directory is gone, the disk is full, the store is not ours — are mostly
    reasons this line cannot be written either. Where it lands it explains a
    gap; where it does not, the gap still shows.
    """
    try:
        STORE.mkdir(parents=True, exist_ok=True)
        with ERROR_LOG.open("a", encoding="utf-8") as log:
            log.write(f"{received_at} {type(error).__name__}: {error}\n")
    except BaseException:
        # Deliberately blind and silent: this is already the failure path, and
        # a hook that raised here would fail the session it exists to observe.
        pass


def on_fedora() -> bool:
    """Whether this host is the Fedora primary — the one machine with a store.

    The same detection sync-dotfiles uses (/proc/version for WSL, then
    /etc/os-release), inlined because a hook runs on bare python3 with no
    package path. Any doubt reads as "not Fedora": on an unreadable or unknown
    host the right amount of capture is none.
    """
    try:
        if "microsoft" in Path("/proc/version").read_text().lower():
            return False
        return any(
            line.removeprefix("ID=").strip().strip('"') == "fedora"
            for line in Path("/etc/os-release").read_text().splitlines()
            if line.startswith("ID=")
        )
    except OSError:
        return False


def main() -> None:
    """Read the event off stdin and record it. Never raises, never exits nonzero.

    Off the Fedora primary the guard returns before reading stdin: capture is
    Fedora-only, and a machine with no store has nothing to append to.

    The timestamp is taken before stdin, so it dates the event's arrival at this
    hook rather than the moment the harness finished handing it over.

    The catch is deliberately blind, and wider than `Exception`: every reason
    this can fail — a locked database, a full disk, a signal — is a reason to
    lose one row, never a reason to fail a session.
    """
    if not on_fedora():
        return
    received_at = datetime.now(UTC).isoformat(timespec="microseconds")
    try:
        # Bytes, then a decode this hook controls: stdin's own decoder follows
        # the locale, which is not UTF-8 everywhere a session might start, and
        # a payload that cannot be decoded is still a payload worth keeping.
        raw = sys.stdin.buffer.read()
        record(received_at, for_storage(raw.decode("utf-8", errors="replace")))
    except BaseException as error:
        note_failure(received_at, error)


if __name__ == "__main__":
    main()
