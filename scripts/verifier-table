#!/usr/bin/env -S uv run --script
"""verifier-table — write standards/verifiers.yaml, and fail where it disagrees.

Thin shim over dev_playbook.verifier_table.main: it puts the checkout's
``src/`` on ``sys.path`` and calls the module, which derives the verifier
table (every rule id declared under ``standards/`` mapped to the address of
the check that decides it, or null) from the rule trailers, each detector's
``--list-rules``, and the dependency map, then compares it with the committed
file (the default) or writes it (``--write``). Findings print to stdout as GNU
finding lines (``file: standard.rule message``) and exit nonzero if any.
``--list-rules`` prints the rule ids and exits 0. pyyaml is declared below
because the module reads pre-commit configs and the shipped table. See
dev_playbook.verifier_table for the logic and its tests.
"""
# /// script
# requires-python = ">=3.14"
# dependencies = ["pyyaml>=6.0"]
# ///

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.verifier_table import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
