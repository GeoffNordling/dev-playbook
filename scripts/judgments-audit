#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["pyyaml>=6.0"]
# ///
"""judgments-audit — pre-commit validator for a repo's judgment declarations.

Thin shim over dev_playbook.judgments.loader.lint: resolve the repo's [tool.judgments]
config, run the loader's field validation plus the static evidence/reference
path checks (relative + exists), print every error, and exit nonzero if any.
A repo with no config validates nothing and exits 0. Fast and deterministic --
no LLM, no hashing. See dev_playbook.judgments.loader for the logic and its tests.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.judgments.loader import lint_cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(lint_cli())
