#!/usr/bin/env -S uv run --script
"""front-clone — open and close a front's throwaway clone for one lap.

Thin shim over ``dev_playbook.front_clone``: it puts the checkout's ``src`` on
the path and calls the library's ``main``. ``open`` clones a repository with
``--no-hardlinks``, verifies the clone shares no object file with its source,
and starts the front's branch at the lap's base commit; ``close`` moves the
front's commits back into the real repository, verifies the branch tip matches,
and deletes the clone. Every check refuses rather than repairs, and a refused
close leaves the clone on disk. Run with ``--help`` for the full behavior.

Usage:
    front-clone open SOURCE DESTINATION BRANCH [--base REF]
    front-clone close CLONE [--keep]
"""
# /// script
# requires-python = ">=3.14"
# ///

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.front_clone import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
