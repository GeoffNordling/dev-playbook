#!/usr/bin/env -S uv run --script
"""Install (or verify) this machine's Claude Code settings.

Claude Code reads exactly one user-scope settings file, `~/.claude/settings.json`,
and offers no user-level local override layer. Machines that must differ --
Fedora carries a PulseAudio sound hook and a bwrap sandbox block that mean
nothing on WSL -- therefore cannot share one checked-in file. So the file is
generated: `dotfiles/settings/base.json` holds everything portable, one
`<machine>.json` fragment holds the remainder, and this installs the merge.

The installed file is a real file, not a symlink into the repo, and hand edits
to it are lost on the next run. `--check` exists to say so out loud: the
session-start hook runs it, so an edit made in the wrong place is reported at
the next session rather than silently reverted.

Output:
    stdout -- what was installed, or what drifted under --check
    exit   -- 0 installed/current, 1 drifted (--check only), 2 cannot run

Usage:
    sync-settings [--check]
"""
# /// script
# requires-python = ">=3.14"
# ///

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.machine import (  # noqa: E402
    detect_machine,
    render,
    settings_for,
)

REPO_ROOT = Path(__file__).resolve().parents[1]
SETTINGS_DIR = REPO_ROOT / "dotfiles" / "settings"
INSTALLED = Path.home() / ".claude" / "settings.json"


def main() -> int:
    """Install the merged settings, or report drift under --check."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--check",
        action="store_true",
        help="report whether the installed file matches, changing nothing",
    )
    args = parser.parse_args()

    machine = detect_machine()
    wanted = render(settings_for(SETTINGS_DIR, machine))

    # A missing file reads as drift rather than as an error: on a fresh machine
    # the check should say "run sync", which is exactly what drift already says.
    installed = INSTALLED.read_text() if INSTALLED.exists() else None

    if args.check:
        if installed == wanted:
            return 0
        print(
            f"Claude Code settings are out of date for this machine ({machine}).\n"
            f"  installed: {INSTALLED}\n"
            f"  source:    {SETTINGS_DIR}/base.json + {machine}.json\n"
            "Run dotfiles/bin/sync-dotfiles.sh to reinstall. If you edited the\n"
            "installed file directly, move the change into the source instead --\n"
            "the installed copy is generated and the edit will be overwritten."
        )
        return 1

    if installed == wanted:
        print(f"settings: already current ({machine})")
        return 0

    INSTALLED.parent.mkdir(parents=True, exist_ok=True)
    # The installed path may still be a symlink into the repo from before
    # settings were generated; writing through it would edit the source.
    INSTALLED.unlink(missing_ok=True)
    INSTALLED.write_text(wanted)
    print(f"settings: installed for {machine} -> {INSTALLED}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
