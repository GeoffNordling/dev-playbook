#!/usr/bin/env -S uv run --script
"""Lint Python sources against the workspace conventions.

Two rules over one walk of a repo's Python files (discovered via
dev_playbook.pyast.find_python_files, so gitignore-aware and worktree-scoped):

  - **no-future-annotations** — ``from __future__ import annotations`` is banned.
    The workspace targets Python >= 3.11, where PEP 604 unions, builtin
    generics, and forward references all work at runtime without it.
  - **empty-init** — every ``__init__.py`` is empty: no docstring, no code.
    Imports, re-exports, and ``__all__`` live in named modules.

The test-privacy family moved to testing-lint, which answers the testing
standard's question rather than Python's.

Output:
    stdout — one finding per line, ``file:line: card.rule message``.
    stderr — one readable summary line.
    exit   — 0 clean, 1 findings, 2 cannot run.

Usage:
    python-lint [directory]
    python-lint --list-rules
"""
# /// script
# requires-python = ">=3.14"
# ///

import argparse
import ast
import sys
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook import pyast  # noqa: E402
from dev_playbook.findings import print_rules, render  # noqa: E402

FUTURE_MESSAGE = "`from __future__ import annotations` is banned (Python >= 3.11)"
INIT_MESSAGE = "`__init__.py` must be empty (no docstring, no code)"

# Every rule id this detector can emit, namespaced by the card whose question
# it answers. Each id is a module-level constant so every emission site
# references the constant, never a raw literal, and RULES (what --list-rules
# prints) cannot drift from what the detector actually emits.
NO_FUTURE_ANNOTATIONS = "python.no-future-annotations"
EMPTY_INIT = "python.empty-init"

RULES = (
    NO_FUTURE_ANNOTATIONS,
    EMPTY_INIT,
)

# Per-rule directory scope. The two rules had different reach as separate hooks,
# and consolidation preserves each rather than silently unifying them:
#   - empty-init policed every tracked __init__.py (no directory exclusions);
#   - no-future-annotations additionally skipped build artifacts and legacy trees
#     we don't police.
# git ls-files already drops gitignored caches; these name filters also cover the
# rare tracked copy. A file is scanned by a rule when none of its parent
# directory names is in that rule's set.
_CACHES = frozenset(
    {
        ".git",
        ".venv",
        ".hatch",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        "__pycache__",
        "node_modules",
    }
)
INIT_EXCLUDE: frozenset[str] = frozenset()
FUTURE_EXCLUDE = _CACHES | frozenset({"build", "dist", "deprecated"})


class ToolError(Exception):
    """The hook could not complete its scan."""


@dataclass(frozen=True)
class Finding:
    file: str
    line: int
    rule: str
    message: str

    def render(self) -> str:
        return render(self.file, self.rule, self.message, self.line)


def check_no_future(rel: str, tree: ast.Module) -> list[Finding]:
    findings: list[Finding] = []
    for node in ast.walk(tree):
        if (
            isinstance(node, ast.ImportFrom)
            and node.module == "__future__"
            and any(alias.name == "annotations" for alias in node.names)
        ):
            findings.append(
                Finding(rel, node.lineno, NO_FUTURE_ANNOTATIONS, FUTURE_MESSAGE)
            )
    return findings


def check_empty_init(rel: str, path: Path) -> list[Finding]:
    """An ``__init__.py`` with any non-whitespace character is an offender.

    Raises ToolError when the file cannot be read as UTF-8 — emptiness is then
    undecidable, so the hook fails loud rather than passing the file silently.
    """
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as err:
        raise ToolError(f"cannot read {rel}: {err}") from err
    if text.strip():
        return [Finding(rel, 1, EMPTY_INIT, INIT_MESSAGE)]
    return []


def scan_file(path: Path, root: Path) -> list[Finding]:
    rel = str(path.relative_to(root))
    dir_parts = set(Path(rel).parts[:-1])
    name = path.name
    findings: list[Finding] = []
    if name == "__init__.py" and not (INIT_EXCLUDE & dir_parts):
        findings.extend(check_empty_init(rel, path))
    tree = pyast.parse(path)
    if tree is None:
        return findings
    if not (FUTURE_EXCLUDE & dir_parts):
        findings.extend(check_no_future(rel, tree))
    return findings


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="python-lint",
        description="Lint Python sources: no-future-annotations, empty-init.",
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="repository root to scan (default: current directory)",
    )
    parser.add_argument(
        "--list-rules",
        action="store_true",
        help="print the rule ids this detector can emit, one per line, and exit",
    )
    args = parser.parse_args(argv)
    if args.list_rules:
        return print_rules(RULES)
    root = Path(args.directory).resolve()

    try:
        files = pyast.find_python_files(root)
        findings: list[Finding] = []
        for path in files:
            findings.extend(scan_file(path, root))
    except ToolError as err:
        print(f"python-lint: {err}", file=sys.stderr)
        return 2

    for f in sorted(findings, key=lambda f: (f.file, f.line, f.rule)):
        print(f.render())

    if findings:
        print(
            f"python-lint: {len(findings)} finding(s) across {len(files)} files",
            file=sys.stderr,
        )
        return 1
    print(f"python-lint: clean across {len(files)} files", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
