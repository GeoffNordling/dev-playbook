#!/usr/bin/env -S uv run --script
"""Lint Python sources against the workspace conventions.

Three rules over one walk of a repo's Python files (discovered via
dev_playbook.pyast.find_python_files, so gitignore-aware and worktree-scoped):

  - **no-future-annotations** — ``from __future__ import annotations`` is banned.
    The workspace targets Python >= 3.11, where PEP 604 unions, builtin
    generics, and forward references all work at runtime without it.
  - **empty-init** — every ``__init__.py`` is empty: no docstring, no code.
    Imports, re-exports, and ``__all__`` live in named modules
    (see standards/python-conventions.md).
  - **test-privacy** — a ``test_*.py`` file must not import or reach into a
    private name (``_foo``) of a non-test module; dunders are public
    (see standards/testing/conventions.md).

Output:
    stdout — one finding per line, ``file:line  rule  message``.
    stderr — one human-readable summary line.
    exit   — 0 clean, 1 findings, 2 cannot run.

Usage:
    python-audit [directory]
"""
# /// script
# requires-python = ">=3.14"
# ///

import argparse
import ast
import sys
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook import pyast  # noqa: E402

FUTURE_MESSAGE = "`from __future__ import annotations` is banned (Python >= 3.11)"
INIT_MESSAGE = "`__init__.py` must be empty (no docstring, no code)"

# Per-rule directory scope. The three rules were separate hooks with different
# reach, and consolidation preserves each rather than silently unifying them:
#   - empty-init policed every tracked __init__.py (no directory exclusions);
#   - test-privacy skipped only caches and virtualenvs;
#   - no-future-annotations additionally skipped build artifacts and the
#     externally-managed / legacy trees we don't police.
# Rules per the workspace Python standard. git ls-files already drops gitignored
# caches; these name filters also cover the rare tracked copy. A file is scanned
# by a rule when none of its parent directory names is in that rule's set.
_CACHES = frozenset(
    {
        ".git",
        ".venv",
        ".hatch",
        ".pytest_cache",
        ".mypy_cache",
        ".ruff_cache",
        "__pycache__",
        "node_modules",
    }
)
INIT_EXCLUDE: frozenset[str] = frozenset()
PRIVACY_EXCLUDE = _CACHES
FUTURE_EXCLUDE = _CACHES | frozenset(
    {"build", "dist", ".agents", ".dhub", "deprecated"}
)


class ToolError(Exception):
    """The hook could not complete its scan."""


@dataclass(frozen=True)
class Finding:
    file: str
    line: int
    rule: str
    message: str

    def render(self) -> str:
        return f"{self.file}:{self.line}  {self.rule}  {self.message}"


def check_no_future(rel: str, tree: ast.Module) -> list[Finding]:
    findings: list[Finding] = []
    for node in ast.walk(tree):
        if (
            isinstance(node, ast.ImportFrom)
            and node.module == "__future__"
            and any(alias.name == "annotations" for alias in node.names)
        ):
            findings.append(
                Finding(rel, node.lineno, "no-future-annotations", FUTURE_MESSAGE)
            )
    return findings


def check_empty_init(rel: str, path: Path) -> list[Finding]:
    """An ``__init__.py`` with any non-whitespace character is an offender.

    Raises ToolError when the file cannot be read as UTF-8 — emptiness is then
    undecidable, so the hook fails loud rather than passing the file silently.
    """
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as err:
        raise ToolError(f"cannot read {rel}: {err}") from err
    if text.strip():
        return [Finding(rel, 1, "empty-init", INIT_MESSAGE)]
    return []


def check_test_privacy(rel: str, tree: ast.Module) -> list[Finding]:
    visitor = _PrivacyVisitor(rel)
    visitor.visit(tree)
    return visitor.findings


def _is_private(name: str) -> bool:
    return name.startswith("_") and not (name.startswith("__") and name.endswith("__"))


def _is_test_module(module: str) -> bool:
    for segment in module.split("."):
        if segment == "tests" or segment.startswith("test_") or segment == "conftest":
            return True
    return False


def _root_name(node: ast.Attribute) -> str | None:
    current: ast.expr = node
    while isinstance(current, ast.Attribute):
        current = current.value
    return current.id if isinstance(current, ast.Name) else None


def _attribute_chain(node: ast.Attribute) -> str:
    parts: list[str] = [node.attr]
    current: ast.expr = node.value
    while isinstance(current, ast.Attribute):
        parts.append(current.attr)
        current = current.value
    if isinstance(current, ast.Name):
        parts.append(current.id)
    return ".".join(reversed(parts))


class _PrivacyVisitor(ast.NodeVisitor):
    """Collect private-access findings within one test file's AST."""

    def __init__(self, rel: str) -> None:
        self.rel = rel
        self.findings: list[Finding] = []
        self._imports: dict[str, str] = {}

    def visit_Import(self, node: ast.Import) -> None:
        for alias in node.names:
            module = alias.name
            local = alias.asname or alias.name.split(".")[0]
            if not _is_test_module(module):
                self._flag_private_segments(node, module)
            self._imports[local] = module
        self.generic_visit(node)

    def visit_ImportFrom(self, node: ast.ImportFrom) -> None:
        module = node.module or ""
        if module and not _is_test_module(module):
            self._flag_private_segments(node, module)
            for alias in node.names:
                if _is_private(alias.name):
                    self._add(
                        node,
                        "privacy.import-private",
                        f"imports private name '{alias.name}' from "
                        f"non-test module '{module}'",
                    )
        for alias in node.names:
            local = alias.asname or alias.name
            self._imports[local] = module
        self.generic_visit(node)

    def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
        self._imports.setdefault(node.name, "")
        self.generic_visit(node)

    def visit_AsyncFunctionDef(self, node: ast.AsyncFunctionDef) -> None:
        self._imports.setdefault(node.name, "")
        self.generic_visit(node)

    def visit_ClassDef(self, node: ast.ClassDef) -> None:
        self._imports.setdefault(node.name, "")
        self.generic_visit(node)

    def visit_Assign(self, node: ast.Assign) -> None:
        for target in node.targets:
            if isinstance(target, ast.Name):
                self._imports.setdefault(target.id, "")
        self.generic_visit(node)

    def visit_Attribute(self, node: ast.Attribute) -> None:
        if _is_private(node.attr):
            root = _root_name(node)
            if root is not None:
                source_module = self._imports.get(root)
                if source_module and not _is_test_module(source_module):
                    self._add(
                        node,
                        "privacy.attribute-access",
                        f"reaches into private name '{node.attr}' on "
                        f"non-test import '{root}' ({_attribute_chain(node)})",
                    )
        self.generic_visit(node)

    def _flag_private_segments(self, node: ast.AST, module: str) -> None:
        for segment in module.split("."):
            if _is_private(segment):
                self._add(
                    node,
                    "privacy.import-private",
                    f"imports through private module segment '{segment}' in '{module}'",
                )
                return

    def _add(self, node: ast.AST, rule: str, message: str) -> None:
        self.findings.append(
            Finding(self.rel, getattr(node, "lineno", 0), rule, message)
        )


def scan_file(path: Path, root: Path) -> list[Finding]:
    rel = str(path.relative_to(root))
    dir_parts = set(Path(rel).parts[:-1])
    name = path.name
    findings: list[Finding] = []
    if name == "__init__.py" and not (INIT_EXCLUDE & dir_parts):
        findings.extend(check_empty_init(rel, path))
    tree = pyast.parse(path)
    if tree is None:
        return findings
    if not (FUTURE_EXCLUDE & dir_parts):
        findings.extend(check_no_future(rel, tree))
    if (
        name.startswith("test_")
        and path.suffix == ".py"
        and not (PRIVACY_EXCLUDE & dir_parts)
    ):
        findings.extend(check_test_privacy(rel, tree))
    return findings


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="python-audit",
        description="Lint Python sources: no-future-annotations, empty-init, test-privacy.",
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="repository root to scan (default: current directory)",
    )
    args = parser.parse_args(argv)
    root = Path(args.directory).resolve()

    try:
        files = pyast.find_python_files(root)
        findings: list[Finding] = []
        for path in files:
            findings.extend(scan_file(path, root))
    except ToolError as err:
        print(f"python-audit: {err}", file=sys.stderr)
        return 2

    for f in sorted(findings, key=lambda f: (f.file, f.line, f.rule)):
        print(f.render())

    if findings:
        print(
            f"python-audit: {len(findings)} finding(s) across {len(files)} files",
            file=sys.stderr,
        )
        return 1
    print(f"python-audit: clean across {len(files)} files", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
