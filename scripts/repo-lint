#!/usr/bin/env -S uv run --script
"""Audit a repo's structure against the workspace build standard.

Deterministic checker for the layered build standard; the standard itself —
layers, skeleton, canonical artifacts — is defined in the standards tree of
the hook repo, not here. Layer membership is inferred from facts on disk,
then each layer's requirements are checked: required files present,
forbidden files absent, working copies matching the canonical artifacts
shipped with this script's clone, name mapping (repo → project → package),
doc shape, script shebangs, and two self-audits: the canonical-directory
audit in the hook repo itself, and the dogfood hook mirror in any repo that
publishes a hook manifest.

Canonical compares come in four strengths, chosen per artifact by the
standard: byte-identical files, verbatim line blocks (extra lines may
surround a block; the hook repo's own `rev` pin is consumer-chosen and
matches any value), baseline .gitignore patterns (comments and order free),
and parsed pyproject.toml values (settings the canonical file pins must
match exactly; additions are free).

Output:
    stdout — one finding per line, ``path: card.rule message``.
    stderr — one human-readable summary line, including the inferred layers.
    exit   — 0 clean, 1 findings, 2 cannot run.

Usage:
    repo-lint [directory]
    repo-lint --list-rules
"""
# /// script
# requires-python = ">=3.14"
# ///

import argparse
import json
import os
import re
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook import gitrepo, md, pyast  # noqa: E402
from dev_playbook.findings import print_rules, render  # noqa: E402

# Every rule id this detector can emit. Most answer the build card. The
# CLAUDE.md voice and global-file checks answer the claude-code card, the
# README/CONTEXT doc-shape check answers the knowledge-organization card, and
# the rogue future-work filenames answer the tracking card.
# Each id is a module-level constant so every emission site references the
# constant, never a raw literal, and RULES (what --list-rules prints) cannot
# drift from what the detector actually emits.
REQUIRED_FILE = "build.required-file"
LAYER_SHAPE = "build.layer-shape"
FORBIDDEN = "build.forbidden"
CANONICAL_BYTES = "build.canonical-bytes"
CANONICAL_BLOCK = "build.canonical-block"
CANONICAL_VALUE = "build.canonical-value"
NAME_MAPPING = "build.name-mapping"
SCRIPT_SHEBANG = "build.script-shebang"
SCRIPT_PYTHON = "build.script-python"
SELF_AUDIT = "build.self-audit"
AGENT_FACING_VOICE = "claude-code.agent-facing-voice"
GLOBAL_CLAUDE_SHAPE = "claude-code.global-claude-shape"
GLOBAL_CLAUDE_RULES = "claude-code.global-claude-rules"
DOC_SHAPE = "knowledge-organization.doc-shape"
ROGUE_FUTURE_WORK = "tracking.rogue-future-work-file"

# Filenames a CANDIDATES.md replaces. Uncommitted work lives in that one
# register, committed work in issues; see standards/tracking/candidates.md.
ROGUE_FUTURE_WORK_NAMES = frozenset({"ROADMAP.md", "TODO.md", "BACKLOG.md", "IDEAS.md"})

RULES = (
    REQUIRED_FILE,
    LAYER_SHAPE,
    FORBIDDEN,
    CANONICAL_BYTES,
    CANONICAL_BLOCK,
    CANONICAL_VALUE,
    NAME_MAPPING,
    SCRIPT_SHEBANG,
    SCRIPT_PYTHON,
    SELF_AUDIT,
    AGENT_FACING_VOICE,
    GLOBAL_CLAUDE_SHAPE,
    GLOBAL_CLAUDE_RULES,
    DOC_SHAPE,
    ROGUE_FUTURE_WORK,
)

HOOK_REPO_ROOT = Path(__file__).resolve().parents[1]
CANONICAL_DIR = HOOK_REPO_ROOT / "standards" / "build" / "canonical"

# Every canonical artifact this script compares against. The hook repo's
# self-audit fails when standards/build/canonical/ and this manifest drift.
CANONICAL_MANIFEST = frozenset(
    {
        "ci.yml",
        ".python-version",
        ".pre-commit-config.yaml",
        "pyproject.toml",
        "Makefile.base",
        "Makefile.python",
        "Makefile.aws",
        "Makefile.sdd",
        ".gitignore",
    }
)

# The consumer chooses this pin; the block compare accepts any value there.
REV_PLACEHOLDER = "<pinned-sha>"

BASE_REQUIRED = (
    "README.md",
    "CLAUDE.md",
    "index.md",
    ".gitignore",
    ".pre-commit-config.yaml",
    "Makefile",
    ".github/workflows/ci.yml",
)
MYPY_ROOTS = ("src", "tests", "scripts")
LOCKFILES = (
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
)
# The same two roots skill-lint scans.
SKILL_ROOTS = (".claude/skills", "dotfiles/dot-claude/skills")
# The rule bodies' matching pair: a consumer repo carries its rules under
# .claude/, dev-playbook authors them in the Stow source tree.
RULE_ROOTS = (".claude/rules", "dotfiles/dot-claude/rules")
# The directory name any repo vendors third-party skills under — dev-playbook's
# dotfiles/.agents, a consumer's own copy. Its contents are carried verbatim so
# they can be re-synced from upstream, so authored-voice rules do not reach
# them; the mirror symlinks that publish them under a skills root are excluded
# with them (conventions.md — Skills vendored verbatim are exempt).
VENDORED_DIR = ".agents"
UV_SHEBANG = "#!/usr/bin/env -S uv run --script"
PEP723_OPEN = "# /// script"
CONTEXT_SECTIONS = (
    "## Language",
    "## Relationships",
    "## Example dialogue",
    "## Flagged ambiguities",
)

# Agent-facing instruction text names the human actor "user" and never speaks in
# first person. Four tokens: the actor-noun "human" (but not the
# "human-readable" compound) and the first-person "I" (but not the "I/O"
# abbreviation), "me", and "my". Only "human" and "I" carry an exemption —
# nothing in the workspace's vocabulary spells "me" or "my" as anything but the
# first person, so neither gets a speculative guard. Inline code, fenced
# blocks, and double-quoted spans are stripped before matching so a backticked
# example or a quoted utterance is not mistaken for prose. Each pattern carries
# its own message: an actor-noun hit and a first-person hit are two different
# faults (conventions.md — Terminology: human vs user).
VOICE_PATTERNS = (
    (
        re.compile(r"\bhuman\b(?!-)", re.IGNORECASE),
        "name the human 'user', not 'human'",
    ),
    (re.compile(r"\bI\b(?!/O)"), "never speak in first person: 'I'"),
    (re.compile(r"\b[Mm]e\b"), "never speak in first person: 'me'"),
    (re.compile(r"\b[Mm]y\b"), "never speak in first person: 'my'"),
)

# A double-quoted span on one line is somebody else's voice — the phrasing a
# user types to trigger a skill, the reaction a prototype is built to provoke —
# so the document is quoting, not speaking. Quotes do not span lines here: a
# lone quotation mark closes at the newline rather than swallowing the rest of
# the file.
QUOTED_SPEECH_PATTERN = re.compile(r'"[^"\n]*"')

# The dev-playbook global CLAUDE.md source, Stow-symlinked to ~/.claude/. Its
# presence is the marker that gates the global-file structural checks to the
# one repo that owns the file (claude-content.md — The global file).
GLOBAL_CLAUDE = "dotfiles/dot-claude/CLAUDE.md"
# The global file's two buckets, in order: dispositional stances, then
# operating rules for named situations.
GLOBAL_CLAUDE_SECTIONS = ("## Principles", "## Behaviors")
# The workspace-wide rules the global file carries for every session, since no
# repo's own CLAUDE.md restates them (claude-content.md — The global file).
GLOBAL_CLAUDE_REQUIRED_RULES = ("### Read the standards", "### Navigate docs by index")


class ToolError(Exception):
    """The audit could not complete its scan."""


@dataclass(frozen=True)
class Finding:
    path: str
    rule: str
    message: str

    def render(self) -> str:
        return render(self.path, self.rule, self.message)


@dataclass(frozen=True)
class Layers:
    python: bool
    src: bool
    scripts_python: bool
    aws: bool
    sdd: bool
    js: bool

    def names(self) -> list[str]:
        flags = [
            ("python", self.python),
            ("src", self.src),
            ("scripts", self.scripts_python),
            ("aws", self.aws),
            ("sdd", self.sdd),
            ("js", self.js),
        ]
        return ["base"] + [name for name, on in flags if on]


def infer_layers(root: Path, python_files: list[Path]) -> Layers:
    return Layers(
        python=(root / "pyproject.toml").is_file(),
        src=(root / "src").is_dir(),
        scripts_python=any(
            p.relative_to(root).parts[:1] == ("scripts",) for p in python_files
        ),
        aws=(root / "cdk.json").is_file(),
        sdd=(root / "specs").is_dir(),
        js=(root / "package.json").is_file(),
    )


def project_name(repo_name: str) -> str:
    return repo_name.lower()


def package_name(repo_name: str) -> str:
    return project_name(repo_name).replace("-", "_")


def in_canonical(rel: str) -> bool:
    """True for paths under standards/build/canonical/ — quoted material, not tree."""
    return rel.startswith("standards/build/canonical/")


def canonical_text(name: str) -> str:
    try:
        return (CANONICAL_DIR / name).read_text(encoding="utf-8")
    except OSError as err:
        raise ToolError(f"cannot read canonical artifact: {err}") from err


def canonical_raw(name: str) -> bytes:
    try:
        return (CANONICAL_DIR / name).read_bytes()
    except OSError as err:
        raise ToolError(f"cannot read canonical artifact: {err}") from err


# --- verbatim line-block compares (.pre-commit-config.yaml, Makefile) ---


def line_matches(canon: str, actual: str) -> bool:
    canon, actual = canon.rstrip(), actual.rstrip()
    if REV_PLACEHOLDER in canon:
        prefix = canon[: canon.index(REV_PLACEHOLDER)]
        return actual.startswith(prefix) and bool(actual[len(prefix) :].strip())
    return canon == actual


def find_run(consumer: list[str], block: list[str], start: int) -> int | None:
    """Index of the first contiguous run matching ``block`` at or after start."""
    n = len(block)
    for i in range(start, len(consumer) - n + 1):
        if all(line_matches(block[j], consumer[i + j]) for j in range(n)):
            return i
    return None


def config_segments(text: str) -> list[list[str]]:
    """Split the canonical pre-commit config at each repo entry.

    Consumers may append hooks inside a block and whole repo blocks between
    blocks; each canonical segment must still appear verbatim, in order.
    """
    segments: list[list[str]] = []
    current: list[str] = []
    for line in text.splitlines():
        if line.startswith("  - repo:") and current:
            segments.append(current)
            current = []
        current.append(line)
    if current:
        segments.append(current)
    return segments


def check_precommit_config(root: Path, hook_repo: bool) -> list[Finding]:
    path = root / ".pre-commit-config.yaml"
    if not path.is_file():
        return []
    consumer = path.read_text(encoding="utf-8").splitlines()
    findings = []
    pos = 0
    for segment in config_segments(canonical_text(".pre-commit-config.yaml")):
        if hook_repo and any(REV_PLACEHOLDER in line for line in segment):
            # The hook repo dogfoods from its working tree instead of a pin;
            # the self-audit checks the dogfood block against the manifest.
            continue
        found = find_run(consumer, segment, pos)
        if found is None:
            findings.append(
                Finding(
                    ".pre-commit-config.yaml",
                    CANONICAL_BLOCK,
                    f"canonical block missing or out of order: '{segment[0].strip()}'",
                )
            )
        else:
            pos = found + len(segment)
    return findings


def check_makefile(
    root: Path, layers: Layers, python_files: list[Path]
) -> list[Finding]:
    path = root / "Makefile"
    if not path.is_file():
        return []
    consumer = path.read_text(encoding="utf-8").splitlines()
    fragments = ["Makefile.python" if layers.python else "Makefile.base"]
    if layers.aws:
        fragments.append("Makefile.aws")
    if layers.sdd:
        fragments.append("Makefile.sdd")
    findings = []
    for name in fragments:
        text = canonical_text(name)
        if name == "Makefile.python":
            # mypy exits 2 on a directory holding no .py files (extensionless
            # scripts don't count), so a root earns its <code-roots> slot only
            # when it actually contains one.
            py_dirs = {
                p.relative_to(root).parts[0] for p in python_files if p.suffix == ".py"
            }
            roots = " ".join(r for r in MYPY_ROOTS if r in py_dirs)
            text = text.replace("<code-roots>", roots)
        if find_run(consumer, text.splitlines(), 0) is None:
            findings.append(
                Finding(
                    "Makefile",
                    CANONICAL_BLOCK,
                    f"canonical {name} targets missing (verbatim; extras may follow)",
                )
            )
    return findings


# --- presence, forbidden, byte compares ---


def check_presence(
    root: Path, layers: Layers, files: list[str], tracked: set[str]
) -> list[Finding]:
    findings = []
    for rel in BASE_REQUIRED:
        if not (root / rel).is_file():
            findings.append(Finding(rel, REQUIRED_FILE, "required in every repo"))
    if layers.python:
        if not (root / ".python-version").is_file():
            findings.append(
                Finding(".python-version", REQUIRED_FILE, "required in a python repo")
            )
        if "uv.lock" not in tracked:
            findings.append(
                Finding("uv.lock", REQUIRED_FILE, "must be committed in a python repo")
            )
    if (layers.src or layers.scripts_python) and not any(
        rel.startswith("tests/") for rel in files
    ):
        findings.append(
            Finding(
                "tests/",
                REQUIRED_FILE,
                "required once src/ exists or scripts/ holds Python",
            )
        )
    if layers.js and not any(name in tracked for name in LOCKFILES):
        findings.append(
            Finding(
                "package.json",
                REQUIRED_FILE,
                "a committed lockfile must sit alongside package.json",
            )
        )
    if layers.aws and not layers.src:
        findings.append(Finding("cdk.json", LAYER_SHAPE, "the aws layer requires src/"))
    if layers.sdd and not layers.python:
        findings.append(
            Finding("specs/", LAYER_SHAPE, "the sdd layer requires the python layer")
        )
    return findings


def check_forbidden(
    root: Path, layers: Layers, files: list[str], tracked: set[str]
) -> list[Finding]:
    findings = []
    for name in ("bin", "tools"):
        if (root / name).is_dir():
            findings.append(
                Finding(
                    f"{name}/",
                    FORBIDDEN,
                    "checked-in runnables live in scripts/, not a root bin/ or tools/",
                )
            )
    for rel in files:
        if in_canonical(rel):
            continue
        base = Path(rel).name
        if base == "requirements.txt":
            findings.append(
                Finding(rel, FORBIDDEN, "dependencies live in pyproject.toml + uv.lock")
            )
        elif base == "pyproject.toml" and rel != "pyproject.toml":
            findings.append(
                Finding(rel, FORBIDDEN, "one Python project per repo, at the root")
            )
        elif base == "CONTEXT.md" and rel != "CONTEXT.md":
            findings.append(
                Finding(rel, FORBIDDEN, "CONTEXT.md lives at the repo root only")
            )
        elif base in ROGUE_FUTURE_WORK_NAMES:
            findings.append(
                Finding(
                    rel,
                    ROGUE_FUTURE_WORK,
                    "uncommitted work lives in CANDIDATES.md, committed work in issues",
                )
            )
        elif base == "CANDIDATES.md" and rel != "CANDIDATES.md":
            findings.append(
                Finding(rel, FORBIDDEN, "CANDIDATES.md lives at the repo root only")
            )
    if layers.aws:
        if (root / "app.py").is_file():
            findings.append(
                Finding(
                    "app.py",
                    FORBIDDEN,
                    "the CDK entry is src/<package>/app.py, not a root app.py",
                )
            )
        if any(rel.startswith("cdk.out/") for rel in tracked):
            findings.append(
                Finding(
                    "cdk.out/", FORBIDDEN, "synth output is gitignored, never committed"
                )
            )
    return findings


def check_canonical_bytes(root: Path) -> list[Finding]:
    findings = []
    pairs = (
        (".github/workflows/ci.yml", "ci.yml"),
        (".python-version", ".python-version"),
    )
    for rel, canon in pairs:
        path = root / rel
        if path.is_file() and path.read_bytes() != canonical_raw(canon):
            findings.append(
                Finding(
                    rel,
                    CANONICAL_BYTES,
                    f"must be byte-identical to the canonical {canon}",
                )
            )
    return findings


def gitignore_patterns(text: str) -> list[str]:
    lines = (line.strip() for line in text.splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def check_gitignore(root: Path) -> list[Finding]:
    path = root / ".gitignore"
    if not path.is_file():
        return []
    have = set(gitignore_patterns(path.read_text(encoding="utf-8")))
    return [
        Finding(".gitignore", CANONICAL_BLOCK, f"missing baseline pattern '{pattern}'")
        for pattern in gitignore_patterns(canonical_text(".gitignore"))
        if pattern not in have
    ]


# --- pyproject.toml: pinned values, parsed ---


def toml_get(data: dict, dotted: str) -> object | None:
    current: object = data
    for key in dotted.split("."):
        if not isinstance(current, dict) or key not in current:
            return None
        current = current[key]
    return current


def check_pyproject(root: Path, layers: Layers, repo_name: str) -> list[Finding]:
    path = root / "pyproject.toml"
    if not layers.python or not path.is_file():
        return []
    try:
        consumer = tomllib.loads(path.read_text(encoding="utf-8"))
    except tomllib.TOMLDecodeError as err:
        return [Finding("pyproject.toml", CANONICAL_VALUE, f"does not parse: {err}")]
    canon = tomllib.loads(canonical_text("pyproject.toml"))
    findings = []

    def pin(dotted: str, expected: object) -> None:
        actual = toml_get(consumer, dotted)
        if actual != expected:
            findings.append(
                Finding(
                    "pyproject.toml",
                    CANONICAL_VALUE,
                    f"{dotted} must be {expected!r}, got {actual!r}",
                )
            )

    pin("project.name", project_name(repo_name))
    pin("project.requires-python", toml_get(canon, "project.requires-python"))
    pin(
        "tool.pytest.ini_options.testpaths",
        toml_get(canon, "tool.pytest.ini_options.testpaths"),
    )
    pin("tool.ruff.target-version", toml_get(canon, "tool.ruff.target-version"))
    pin("tool.ruff.line-length", toml_get(canon, "tool.ruff.line-length"))
    pin("tool.ruff.lint.select", toml_get(canon, "tool.ruff.lint.select"))
    pin("tool.ruff.lint.ignore", toml_get(canon, "tool.ruff.lint.ignore"))
    pin(
        "tool.ruff.lint.pydocstyle.convention",
        toml_get(canon, "tool.ruff.lint.pydocstyle.convention"),
    )
    pin("tool.ruff.lint.isort.known-first-party", [package_name(repo_name)])
    mypy = toml_get(canon, "tool.mypy")
    assert isinstance(mypy, dict)
    for key, expected in mypy.items():
        pin(f"tool.mypy.{key}", expected)

    floors = toml_get(canon, "dependency-groups.dev")
    assert isinstance(floors, list)
    dev = toml_get(consumer, "dependency-groups.dev")
    dev = dev if isinstance(dev, list) else []
    for floor in floors:
        if floor not in dev:
            findings.append(
                Finding(
                    "pyproject.toml",
                    CANONICAL_VALUE,
                    f"dependency-groups.dev must contain {floor!r}",
                )
            )

    if layers.src:
        build = toml_get(canon, "build-system")
        assert isinstance(build, dict)
        for key, expected in build.items():
            pin(f"build-system.{key}", expected)
    else:
        if toml_get(consumer, "build-system") is not None:
            findings.append(
                Finding(
                    "pyproject.toml",
                    CANONICAL_VALUE,
                    "a scripts-only repo (no src/) omits [build-system]",
                )
            )
        pin("tool.uv.package", False)
    return findings


# --- name mapping, cdk, docs, scripts, skills ---


def check_src_package(
    root: Path, layers: Layers, files: list[str], repo_name: str
) -> list[Finding]:
    if not layers.src:
        return []
    pkg = package_name(repo_name)
    children = {
        Path(rel).parts[1]
        for rel in files
        if rel.startswith("src/") and len(Path(rel).parts) > 1
    }
    findings = []
    for extra in sorted(children - {pkg}):
        findings.append(
            Finding(
                f"src/{extra}",
                NAME_MAPPING,
                f"src/ holds exactly one package, named '{pkg}'",
            )
        )
    if pkg not in children:
        findings.append(
            Finding(
                f"src/{pkg}/",
                NAME_MAPPING,
                f"src/ holds exactly one package, named '{pkg}'",
            )
        )
    if layers.aws and not (root / "src" / pkg / "app.py").is_file():
        findings.append(
            Finding(f"src/{pkg}/app.py", REQUIRED_FILE, "the aws layer's CDK entry")
        )
    return findings


def check_cdk(root: Path, layers: Layers, repo_name: str) -> list[Finding]:
    if not layers.aws:
        return []
    expected = f"uv run python -m {package_name(repo_name)}.app"
    try:
        data = json.loads((root / "cdk.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as err:
        return [Finding("cdk.json", CANONICAL_VALUE, f"does not parse: {err}")]
    actual = data.get("app")
    if actual != expected:
        return [
            Finding(
                "cdk.json", CANONICAL_VALUE, f"app must be {expected!r}, got {actual!r}"
            )
        ]
    return []


def body_lines(path: Path) -> list[str]:
    """A doc's lines outside frontmatter and fenced code, right-stripped.

    Frontmatter is split textually rather than through md.parse_frontmatter
    because this script declares no dependencies and that helper needs pyyaml
    on the interpreter.
    """
    text = path.read_text(encoding="utf-8", errors="replace")
    if text.startswith("---\n"):
        end = text.find("\n---\n", 4)
        if end != -1:
            text = text[end + 5 :]
    return [line.rstrip() for _, line in md.lines_outside_fences(text)]


def is_vendored(root: Path, path: Path) -> bool:
    """Whether a scanned file is third-party content under a vendored root.

    Two ways a file can be one: it sits inside the vendored tree, or it is a
    mirror symlink published under a skills root, which git lists under its own
    path — so the resolved target is tested too, and a target outside the repo
    is tested whole.
    """
    real = path.resolve()
    real_parts = (
        real.relative_to(root).parts if real.is_relative_to(root) else real.parts
    )
    return VENDORED_DIR in path.relative_to(root).parts or VENDORED_DIR in real_parts


def check_agent_facing_voice(root: Path) -> list[Finding]:
    """Agent-facing instruction text — every CLAUDE.md (root, nested, and the
    dev-playbook global source) plus every first-party skill and rule body — is
    written for the executing agent alone, so it names the human "user" and
    never speaks in first person (claude-content.md, conventions.md). Runs in
    every repo, inspecting only that repo's own files; a consumer's skills and
    rules sit under .claude/, dev-playbook's under the Stow source tree, and
    vendored third-party skills are exempt wherever they surface. A skill's
    frontmatter is in scope: its description is prose the agent reads to choose
    the skill. Inline code, fenced blocks, and quoted speech are skipped so a
    backticked example or a quoted utterance does not read as prose.
    """
    instruction_roots = tuple(f"{r}/" for r in SKILL_ROOTS + RULE_ROOTS)
    findings = []
    for path in md.find_md_files(root):
        rel = path.relative_to(root).as_posix()
        if path.name != "CLAUDE.md" and not rel.startswith(instruction_roots):
            continue
        if is_vendored(root, path):
            continue
        for num, line in md.content_lines(path):
            masked = QUOTED_SPEECH_PATTERN.sub("", md.INLINE_CODE_PATTERN.sub("", line))
            for pattern, fault in VOICE_PATTERNS:
                if pattern.search(masked):
                    findings.append(
                        Finding(rel, AGENT_FACING_VOICE, f"line {num}: {fault}")
                    )
    return findings


def check_global_claude(root: Path) -> list[Finding]:
    """The global CLAUDE.md source buckets its rules under exactly two H2s,
    '## Principles' then '## Behaviors', and carries the workspace-wide rules
    every session needs (claude-content.md — The global file). Gated on the
    source file's presence, so it runs only in the repo that owns it; other
    repos have no global file. Headings inside fenced blocks do not count, so a
    worked example in the file does not read as a section of it.

    The required-rules check is what stations the workspace-wide instructions:
    no repo's own CLAUDE.md restates them, so this file is the only place they
    can be checked.
    """
    path = root / GLOBAL_CLAUDE
    if not path.is_file():
        return []
    headings = [
        line.strip() for _, line in md.content_lines(path) if line.startswith("#")
    ]
    sections = tuple(h for h in headings if h.startswith("## "))
    findings = []
    if sections != GLOBAL_CLAUDE_SECTIONS:
        findings.append(
            Finding(
                GLOBAL_CLAUDE,
                GLOBAL_CLAUDE_SHAPE,
                f"H2 sections must be exactly {list(GLOBAL_CLAUDE_SECTIONS)},"
                f" got {list(sections)}",
            )
        )
    findings.extend(
        Finding(GLOBAL_CLAUDE, GLOBAL_CLAUDE_RULES, f"missing rule '{rule}'")
        for rule in GLOBAL_CLAUDE_REQUIRED_RULES
        if rule not in headings
    )
    return findings


def check_doc_shapes(root: Path) -> list[Finding]:
    findings = []
    readme = root / "README.md"
    if readme.is_file() and not any(
        re.match(r"^# +\S", line) for line in body_lines(readme)
    ):
        findings.append(Finding("README.md", DOC_SHAPE, "missing an H1 title"))
    context = root / "CONTEXT.md"
    if context.is_file():
        lines = body_lines(context)
        findings.extend(
            Finding("CONTEXT.md", DOC_SHAPE, f"missing section '{section}'")
            for section in CONTEXT_SECTIONS
            if section not in lines
        )
    return findings


def check_scripts(
    root: Path, layers: Layers, python_files: list[Path]
) -> list[Finding]:
    if not layers.scripts_python:
        return []
    # Each script's PEP 723 floor must equal the repo's interpreter pin; with
    # no .python-version yet there is nothing to compare against (its absence
    # is already a presence finding in a python repo).
    pin = root / ".python-version"
    floor = f">={pin.read_text(encoding='utf-8').strip()}" if pin.is_file() else None
    findings = []
    for path in python_files:
        rel = path.relative_to(root)
        if rel.parts[:1] != ("scripts",) or not os.access(path, os.X_OK):
            continue
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        if not lines or lines[0].rstrip() != UV_SHEBANG:
            findings.append(
                Finding(
                    str(rel),
                    SCRIPT_SHEBANG,
                    f"executable Python in scripts/ opens with '{UV_SHEBANG}'",
                )
            )
        if not any(line.strip() == PEP723_OPEN for line in lines):
            findings.append(
                Finding(
                    str(rel),
                    SCRIPT_SHEBANG,
                    f"missing PEP 723 inline metadata block ('{PEP723_OPEN}')",
                )
            )
        elif floor is not None:
            declared = next(
                (
                    m.group(1)
                    for line in lines
                    if (
                        m := re.match(
                            r'#\s*requires-python\s*=\s*"([^"]*)"', line.strip()
                        )
                    )
                ),
                None,
            )
            if declared != floor:
                findings.append(
                    Finding(
                        str(rel),
                        SCRIPT_PYTHON,
                        f'PEP 723 requires-python must be "{floor}"'
                        " (the repo's .python-version floor)",
                    )
                )
    return findings


def hook_ids(config_text: str) -> list[tuple[str | None, str]]:
    """(repo, id) for each hook reference in a pre-commit config."""
    pairs: list[tuple[str | None, str]] = []
    current: str | None = None
    for line in config_text.splitlines():
        repo = re.match(r"^\s*-\s*repo:\s*(\S+)", line)
        if repo:
            current = repo.group(1)
            continue
        hook = re.match(r"^\s*-\s*id:\s*(\S+)", line)
        if hook:
            pairs.append((current, hook.group(1)))
    return pairs


# --- self-audit: canonical artifacts (hook repo) and dogfood mirror (manifest) ---


def check_canonical_artifacts(root: Path) -> list[Finding]:
    """Diff the hook repo's canonical directory against CANONICAL_MANIFEST.

    Gated on the hook-repo condition: only dev-playbook carries
    standards/build/canonical/, so only it owns the ten canonical artifacts.
    """
    canon_dir = root / "standards" / "build" / "canonical"
    present = {p.name for p in canon_dir.iterdir() if p.is_file()}
    findings = []
    for name in sorted(present - CANONICAL_MANIFEST):
        findings.append(
            Finding(
                f"standards/build/canonical/{name}",
                SELF_AUDIT,
                "no repo-lint compare covers this canonical artifact",
            )
        )
    for name in sorted(CANONICAL_MANIFEST - present):
        findings.append(
            Finding(
                f"standards/build/canonical/{name}",
                SELF_AUDIT,
                "canonical artifact missing from standards/build/canonical/",
            )
        )
    return findings


def check_dogfood_mirror(root: Path) -> list[Finding]:
    """Assert every id a repo publishes is dogfooded in its local hooks.

    Gated on the manifest condition: any repo publishing a
    .pre-commit-hooks.yaml must run what it ships (the hosting-pattern
    invariant), not just the hook repo.
    """
    manifest = root / ".pre-commit-hooks.yaml"
    published = {
        m.group(1)
        for m in re.finditer(
            r"^- +id:\s*(\S+)", manifest.read_text(encoding="utf-8"), re.M
        )
    }
    config = root / ".pre-commit-config.yaml"
    local = (
        {
            hook
            for repo, hook in hook_ids(config.read_text(encoding="utf-8"))
            if repo == "local"
        }
        if config.is_file()
        else set()
    )
    # Subset, not equality: every published hook must be dogfooded, while
    # local-only hooks (e.g. make-check) are free additions.
    missing = published - local
    if missing:
        return [
            Finding(
                ".pre-commit-config.yaml",
                SELF_AUDIT,
                f"dogfood local hooks must cover the published manifest "
                f"(missing: {', '.join(sorted(missing))})",
            )
        ]
    return []


def audit(root: Path, repo_name: str) -> tuple[list[Finding], Layers]:
    files = gitrepo.git_files(root)
    tracked = set(gitrepo.git_files(root, tracked_only=True))
    python_files = pyast.find_python_files(root)
    layers = infer_layers(root, python_files)
    # Two independent conditions. hook_repo is dev-playbook alone (it carries
    # the canonical directory); has_manifest is any repo hosting a hook
    # manifest, including a consumer that dogfoods what it publishes.
    hook_repo = (root / "standards" / "build" / "canonical").is_dir()
    has_manifest = (root / ".pre-commit-hooks.yaml").is_file()

    findings = [
        *check_presence(root, layers, files, tracked),
        *check_forbidden(root, layers, files, tracked),
        *check_canonical_bytes(root),
        *check_gitignore(root),
        *check_precommit_config(root, hook_repo),
        *check_makefile(root, layers, python_files),
        *check_pyproject(root, layers, repo_name),
        *check_src_package(root, layers, files, repo_name),
        *check_cdk(root, layers, repo_name),
        *check_agent_facing_voice(root),
        *check_global_claude(root),
        *check_doc_shapes(root),
        *check_scripts(root, layers, python_files),
    ]
    if hook_repo:
        findings += check_canonical_artifacts(root)
    if has_manifest:
        findings += check_dogfood_mirror(root)
    return findings, layers


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="repo-lint",
        description="Audit a repo's structure against the workspace build standard.",
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="repository root to audit (default: current directory)",
    )
    parser.add_argument(
        "--list-rules",
        action="store_true",
        help="print the rule ids this detector can emit, one per line, and exit",
    )
    args = parser.parse_args(argv)
    if args.list_rules:
        return print_rules(RULES)
    root = Path(args.directory).resolve()

    try:
        repo_name = gitrepo.canonical_repo_name(root)
    except gitrepo.NotAGitRepository:
        print(f"repo-lint: not a git repository: {root}", file=sys.stderr)
        return 2
    try:
        findings, layers = audit(root, repo_name)
    except ToolError as err:
        print(f"repo-lint: {err}", file=sys.stderr)
        return 2

    for finding in sorted(findings, key=lambda f: (f.path, f.rule, f.message)):
        print(finding.render())

    layer_list = ", ".join(layers.names())
    if findings:
        print(
            f"repo-lint: {len(findings)} finding(s) (layers: {layer_list})",
            file=sys.stderr,
        )
        return 1
    print(f"repo-lint: clean (layers: {layer_list})", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
