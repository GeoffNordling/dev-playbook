#!/usr/bin/env -S uv run --script
"""Audit internal SKILL.md files for skill-conventions.md conformance.

Scans skill bundles authored in this repo against the conventions in
dev-playbook's standards/claude-code/skill-conventions.md. Two skill roots are checked
when present in the target directory:

  - .claude/skills/                (project-level skills, any repo)
  - dotfiles/dot-claude/skills/    (workspace-global skills, dev-playbook only)

Externally-managed skills (those whose bundle directory is a symlink,
typically pointing into dotfiles/.agents/skills/) are skipped — their
conformance is the upstream's concern. Exits 0 silently when neither root
exists, so the same invocation is safe in any repo.

Output:
    stdout — one finding per line, `file: claude-code.rule message`.
    stderr — non-failing advisories (body length) and one summary line.
    exit   — 0 clean, 1 findings.

Usage:
    skill-audit [directory]
    skill-audit --list-rules
"""
# /// script
# requires-python = ">=3.14"
# dependencies = ["pyyaml"]
# ///

import argparse
import re
import sys
from dataclasses import dataclass
from pathlib import Path

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.findings import print_rules, render  # noqa: E402

# Every rule id this detector can emit — the skill conventions live under the
# claude-code card. body-length is not here: it is a non-failing stderr advisory,
# not a finding.
RULES = (
    "claude-code.parse",
    "claude-code.front-matter",
    "claude-code.required-field",
    "claude-code.banned-field",
    "claude-code.name-match",
    "claude-code.name-format",
    "claude-code.description-type",
    "claude-code.description-length",
    "claude-code.description-trigger",
    "claude-code.model-value",
    "claude-code.effort-value",
    "claude-code.dmi-type",
    "claude-code.body-h1",
    "claude-code.references-depth",
)

REQUIRED_FIELDS = ("name", "description", "disable-model-invocation", "model", "effort")
BANNED_FIELDS = ("user-invocable",)
VALID_MODELS = ("haiku", "sonnet", "opus", "fable")
VALID_EFFORTS = ("low", "medium", "high", "xhigh")
KEBAB_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
LINK_RE = re.compile(r"\[[^\]]+\]\(([^)]+)\)")
DESCRIPTION_MAX = 1024
BODY_MAX_LINES = 100


@dataclass
class Finding:
    file: str
    check: str
    message: str

    def render(self) -> str:
        return render(self.file, self.check, self.message)


def parse_skill(path: Path) -> tuple[dict | None, str]:
    """Parse YAML front matter and body from a SKILL.md file."""
    text = path.read_text()
    if not text.startswith("---\n"):
        return None, text

    end = text.index("\n---\n", 4)
    front_matter = yaml.safe_load(text[4:end])
    body = text[end + 5 :]
    return front_matter, body


def check_required_fields(fm: dict, rel: str) -> list[Finding]:
    return [
        Finding(rel, "claude-code.required-field", f"missing '{field}'")
        for field in REQUIRED_FIELDS
        if field not in fm
    ]


def check_banned_fields(fm: dict, rel: str) -> list[Finding]:
    return [
        Finding(rel, "claude-code.banned-field", f"'{field}' must not be present")
        for field in BANNED_FIELDS
        if field in fm
    ]


def check_name(fm: dict, dir_name: str, rel: str) -> list[Finding]:
    findings = []
    name = fm.get("name")
    if name is None:
        return findings

    if name != dir_name:
        findings.append(
            Finding(
                rel,
                "claude-code.name-match",
                f"name '{name}' does not match directory '{dir_name}'",
            )
        )
    if not KEBAB_RE.match(name):
        findings.append(Finding(rel, "claude-code.name-format", f"name '{name}' is not kebab-case"))
    return findings


def check_description(fm: dict, rel: str) -> list[Finding]:
    findings = []
    desc = fm.get("description")
    if desc is None:
        return findings
    if not isinstance(desc, str):
        return [
            Finding(
                rel,
                "claude-code.description-type",
                f"description must be a string, got {type(desc).__name__}",
            )
        ]

    if len(desc) > DESCRIPTION_MAX:
        findings.append(
            Finding(
                rel,
                "claude-code.description-length",
                f"description is {len(desc)} chars (max {DESCRIPTION_MAX})",
            )
        )

    if fm.get("disable-model-invocation") is False and "Use when" not in desc:
        findings.append(
            Finding(
                rel,
                "claude-code.description-trigger",
                "auto-invocable description should include a 'Use when …' sentence "
                "naming trigger keywords/contexts/file types",
            )
        )

    return findings


def check_model(fm: dict, rel: str) -> list[Finding]:
    model = fm.get("model")
    if model is None:
        return []
    if model not in VALID_MODELS:
        return [Finding(rel, "claude-code.model-value", f"model '{model}' not in {VALID_MODELS}")]
    return []


def check_effort(fm: dict, rel: str) -> list[Finding]:
    effort = fm.get("effort")
    if effort is None:
        return []
    if effort not in VALID_EFFORTS:
        return [
            Finding(rel, "claude-code.effort-value", f"effort '{effort}' not in {VALID_EFFORTS}")
        ]
    return []


def check_disable_model_invocation(fm: dict, rel: str) -> list[Finding]:
    value = fm.get("disable-model-invocation")
    if value is None:
        return []
    if not isinstance(value, bool):
        return [
            Finding(
                rel,
                "claude-code.dmi-type",
                f"disable-model-invocation must be boolean, got '{value}'",
            )
        ]
    return []


def check_body_h1(body: str, rel: str) -> list[Finding]:
    for line in body.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if stripped.startswith("# "):
            return []
        return [
            Finding(rel, "claude-code.body-h1", f"body must start with H1, got: '{stripped[:40]}'")
        ]
    return [Finding(rel, "claude-code.body-h1", "body is empty")]


def body_length_advisory(body: str, rel: str) -> str | None:
    """A non-failing stderr advisory when a SKILL.md body runs long.

    Never a finding: the body-length rule is a nudge, not a gate — it prints to
    stderr and never affects the exit code.
    """
    n = len(body.splitlines())
    if n > BODY_MAX_LINES:
        return (
            f"{rel}: SKILL.md body is {n} lines (>{BODY_MAX_LINES}); "
            "consider spilling into references/"
        )
    return None


def check_references_depth(skill_dir: Path, rel_dir: str) -> list[Finding]:
    refs_dir = skill_dir / "references"
    if not refs_dir.is_dir():
        return []

    findings = []
    refs_resolved = refs_dir.resolve()
    for md_file in sorted(refs_dir.glob("*.md")):
        rel_md = f"{rel_dir}/references/{md_file.name}"
        text = md_file.read_text()
        for match in LINK_RE.finditer(text):
            target = match.group(1).split("#", 1)[0].strip()
            if not target or target.startswith(
                ("http://", "https://", "mailto:", "~", "/")
            ):
                continue
            try:
                resolved = (md_file.parent / target).resolve()
            except OSError:
                continue
            if (
                resolved != md_file.resolve()
                and resolved.parent == refs_resolved
                and resolved.suffix == ".md"
            ):
                findings.append(
                    Finding(
                        rel_md,
                        "claude-code.references-depth",
                        f"link to sibling reference file '{target}' "
                        "(references/ must be one level deep)",
                    )
                )
    return findings


def audit_skill(skill_dir: Path, repo_root: Path) -> tuple[list[Finding], list[str]]:
    """Return ``(findings, advisories)`` for one skill bundle.

    findings are blocking (they set the exit code); advisories are non-failing
    stderr nudges (currently only the body-length advisory).
    """
    skill_md = skill_dir / "SKILL.md"
    if not skill_md.is_file():
        return [], []

    rel = str(skill_md.relative_to(repo_root))
    rel_dir = str(skill_dir.relative_to(repo_root))
    dir_name = skill_dir.name

    try:
        fm, body = parse_skill(skill_md)
    except Exception as e:
        return [Finding(rel, "claude-code.parse", str(e))], []

    if fm is None:
        return [Finding(rel, "claude-code.front-matter", "no YAML front matter found")], []

    findings = []
    findings.extend(check_required_fields(fm, rel))
    findings.extend(check_banned_fields(fm, rel))
    findings.extend(check_name(fm, dir_name, rel))
    findings.extend(check_description(fm, rel))
    findings.extend(check_model(fm, rel))
    findings.extend(check_effort(fm, rel))
    findings.extend(check_disable_model_invocation(fm, rel))
    findings.extend(check_body_h1(body, rel))
    findings.extend(check_references_depth(skill_dir, rel_dir))

    advisory = body_length_advisory(body, rel)
    advisories = [advisory] if advisory is not None else []
    return findings, advisories


def discover_internal_skills(skills_dir: Path) -> tuple[list[Path], int]:
    """Return (internal_skill_dirs, externally_managed_count).

    A skill is "externally managed" when its bundle directory is a symlink —
    typically a Stow-style symlink into dotfiles/.agents/skills/. Those
    skills are owned upstream; their conformance is not this repo's concern.
    """
    internal = []
    skipped = 0
    for entry in sorted(skills_dir.iterdir()):
        if not entry.is_dir():
            continue
        if entry.is_symlink():
            skipped += 1
            continue
        internal.append(entry)
    return internal, skipped


def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="Repository root to scan (default: current directory)",
    )
    parser.add_argument(
        "--list-rules",
        action="store_true",
        help="print the rule ids this detector can emit, one per line, and exit",
    )
    args = parser.parse_args()
    if args.list_rules:
        sys.exit(print_rules(RULES))

    repo_root = Path(args.directory).resolve()

    skill_roots = [
        p
        for p in (
            repo_root / ".claude" / "skills",
            repo_root / "dotfiles" / "dot-claude" / "skills",
        )
        if p.is_dir()
    ]

    if not skill_roots:
        print("skill-audit: no skill roots found", file=sys.stderr)
        sys.exit(0)

    internal_skills: list[Path] = []
    skipped = 0
    for root in skill_roots:
        roots_internal, roots_skipped = discover_internal_skills(root)
        internal_skills.extend(roots_internal)
        skipped += roots_skipped

    if not internal_skills:
        print("skill-audit: no internal skills found", file=sys.stderr)
        sys.exit(0)

    all_findings: list[Finding] = []
    all_advisories: list[str] = []
    for skill_dir in internal_skills:
        findings, advisories = audit_skill(skill_dir, repo_root)
        all_findings.extend(findings)
        all_advisories.extend(advisories)

    for f in all_findings:
        print(f.render())
    for advisory in all_advisories:
        print(f"skill-audit: {advisory}", file=sys.stderr)

    errors = len(all_findings)
    skills = len(internal_skills)
    suffix = f" (skipped {skipped} external)" if skipped else ""
    if errors:
        print(
            f"skill-audit: {skills} internal skills, {errors} finding(s), "
            f"{len(all_advisories)} advisory(ies){suffix}",
            file=sys.stderr,
        )
    else:
        print(
            f"skill-audit: {skills} internal skills, all ok{suffix}",
            file=sys.stderr,
        )

    sys.exit(1 if errors else 0)


if __name__ == "__main__":
    main()
