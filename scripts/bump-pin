#!/usr/bin/env -S uv run --script
"""bump-pin — check whether one consumer repo's dev-playbook pin can move, or move it.

Thin shim over ``dev_playbook.pins.bump``: it puts the checkout's ``src`` on
the path and calls the library's ``main``. ``--check`` probes the bump in a
throwaway worktree of the consumer's ``origin/main`` — the gate at the current
pin, the pin and its hook ids moved, the gate again — and reports the verdict,
leaving the caller's checkout untouched; ``--write`` makes the durable edit and
runs no gate. The target is always dev-playbook's release head, its published
``main`` less the pin ledger's own commits. It commits nothing and pushes
nothing. Run with ``--help`` for the full behavior.

Usage:
    bump-pin (--check | --write) [REPO]
"""
# /// script
# requires-python = ">=3.14"
# dependencies = ["pyyaml>=6.0"]
# ///

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.pins.bump import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
