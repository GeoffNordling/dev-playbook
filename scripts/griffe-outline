#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["griffe"]
# ///
"""griffe-outline — print the structure of a Python package.

Lists its classes, functions, type-hinted signatures, and first-line
docstrings, by static analysis via griffe.

Usage:
    griffe-outline src/mypackage
    griffe-outline src/mypackage > structure.txt
    griffe-outline src/mypackage --search src   # extra search paths for griffe
"""

import argparse
import sys
from pathlib import Path

import griffe


def members_of_kind(parent, kind):
    """Locally-defined members of ``parent`` whose resolved kind is ``kind``.

    An imported or re-exported member is a griffe *alias* (``is_alias`` is
    True); selecting only non-alias members keeps each member listed once, at
    its real definition site, instead of again under every module that imports
    it. The ``not m.is_alias`` guard short-circuits before ``.kind`` is read,
    because resolving an unresolvable alias (e.g. ``from typing import
    Protocol``) raises ``AliasResolutionError``.
    """
    return [
        m for m in parent.members.values() if not m.is_alias and m.kind.value == kind
    ]


def format_param(p):
    """One parameter as ``name: annotation = default``."""
    s = p.name
    if p.annotation is not None:
        s += f": {p.annotation}"
    if p.default is not None:
        s += f" = {p.default}"
    return s


def format_function(func, indent=0):
    """Print a function's decorators, signature, and first docstring line."""
    prefix = "  " * indent

    for dec in func.decorators:
        print(f"{prefix}@{dec.value}")

    params = [format_param(p) for p in func.parameters if p.name not in ("self", "cls")]
    ret = f" -> {func.returns}" if func.returns else ""
    print(f"{prefix}def {func.name}({', '.join(params)}){ret}")

    if func.docstring:
        first_line = func.docstring.value.split("\n")[0].strip()
        if first_line:
            print(f'{prefix}    """{first_line}"""')
    print()


def format_class(cls, indent=0):
    """Print a class's header and docstring line, then its attributes and methods."""
    prefix = "  " * indent

    for dec in cls.decorators:
        print(f"{prefix}@{dec.value}")

    bases = [str(b) for b in cls.bases]
    base_part = f"({', '.join(bases)})" if bases else ""
    print(f"{prefix}class {cls.name}{base_part}:")

    if cls.docstring:
        first_line = cls.docstring.value.split("\n")[0].strip()
        if first_line:
            print(f'{prefix}    """{first_line}"""')

    attrs = members_of_kind(cls, "attribute")
    methods = members_of_kind(cls, "function")

    for attr in attrs:
        ann = f": {attr.annotation}" if attr.annotation is not None else ""
        print(f"{prefix}    {attr.name}{ann}")

    if methods:
        if attrs:
            print()
        for method in methods:
            format_function(method, indent + 2)

    if not attrs and not methods:
        print(f"{prefix}    ...")
    print()


def format_module(mod, path=""):
    """Print a module's classes and functions, then each submodule's."""
    full_path = f"{path}.{mod.name}" if path else mod.name

    submodules = members_of_kind(mod, "module")
    classes = members_of_kind(mod, "class")
    functions = members_of_kind(mod, "function")

    if classes or functions:
        header = f"{'=' * 60}\n{full_path}"
        if mod.docstring:
            first_line = mod.docstring.value.split("\n")[0].strip()
            if first_line:
                header += f"\n  {first_line}"
        print(header)
        print("=" * 60)
        print()

        for c in classes:
            format_class(c)
        for f in functions:
            format_function(f)

    for sub in submodules:
        format_module(sub, full_path)


def main():
    """Load the package named on the command line and print its outline."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "package", help="Path to the Python package (e.g. src/mypackage)"
    )
    parser.add_argument(
        "--search",
        "-s",
        action="append",
        default=[],
        help="Extra search paths for griffe (repeatable)",
    )
    args = parser.parse_args()

    pkg_path = Path(args.package)
    if pkg_path.is_dir():
        module_name = pkg_path.name
        search = [str(pkg_path.parent)] + args.search
    else:
        module_name = args.package
        search = args.search or None

    try:
        pkg = griffe.load(module_name, search_paths=search)
    except Exception as e:
        print(f"Could not load package: {args.package}\n{e}", file=sys.stderr)
        sys.exit(1)

    format_module(pkg)


if __name__ == "__main__":
    main()
