#!/usr/bin/env -S uv run --script
"""bootstrap-labels — enforce the workspace's GitHub label scheme in the current repo.

Closed-world: labels in the canonical set are created or updated to match;
labels not in the canonical set are deleted. Idempotent. The canonical scheme is
policy-as-data in ``dev_playbook.label_scheme`` (``label_scheme.json``); this
script is the thin shim that mints it into the current repo over `gh`. See
~/workspace/dev-playbook/software-factory/software-factory.md (§Valid labels and §Naming) for the
scheme's semantic authority.
"""
# /// script
# requires-python = ">=3.14"
# ///

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.label_scheme import canonical_labels  # noqa: E402


def existing() -> dict[str, dict[str, str]]:
    out = subprocess.run(
        ["gh", "label", "list", "--json", "name,color,description", "--limit", "200"],
        check=True,
        capture_output=True,
        text=True,
    )
    return {
        item["name"]: {"color": item["color"], "description": item["description"]}
        for item in json.loads(out.stdout)
    }


def main() -> int:
    have = existing()
    labels = canonical_labels()
    canonical = {name for name, _, _ in labels}

    for name, color, desc in labels:
        if name not in have:
            subprocess.run(
                [
                    "gh",
                    "label",
                    "create",
                    name,
                    "--color",
                    color,
                    "--description",
                    desc,
                ],
                check=True,
                capture_output=True,
            )
            print(f"created   {name}")
        elif (
            have[name]["description"] != desc
            or have[name]["color"].lower() != color.lower()
        ):
            subprocess.run(
                ["gh", "label", "edit", name, "--color", color, "--description", desc],
                check=True,
                capture_output=True,
            )
            print(f"updated   {name}")
        else:
            print(f"unchanged {name}")

    for name in sorted(have):
        if name in canonical:
            continue
        subprocess.run(
            ["gh", "label", "delete", name, "--yes"],
            check=True,
            capture_output=True,
        )
        print(f"deleted   {name}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
