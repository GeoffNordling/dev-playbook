#!/usr/bin/env -S uv run --script
"""Lint the repo's Open Knowledge Format (OKF) bundle.

Three checks over one walk of the bundle, their rules namespaced by the card
that owns them — `knowledge-organization.*` for the first two,
`instrument.*` for the third (instruments):

  - **Type-lint** — every concept document carries frontmatter with a `type`
    drawn from the type registry, plus `title` and `description`. `resource`
    is optional in general and required on a `Recipe-Description`, and a
    document typed `Standard` lives under `standards/` — the tree reserved for
    normative conformance targets (`knowledge-organization.type-location`). The registry
    is two-level. In apex mode — the audited tree hosts the canonical consumer
    template (`CANONICAL_CONFIG`), i.e. dev-playbook itself — it is that tree's
    own `## Types` table (`REGISTRY_DOC`), read and shape-checked there as the
    sole source of truth, with no union and no shadow rule. In consumer mode —
    every other repo — the authoritative registry is read from this script's own
    hook clone (`UPSTREAM_REGISTRY_ROOT`); if the audited tree carries its own
    `document-types.md`, that file is a local *extension* whose valid types
    union onto the upstream set (additive only — a local type may be added but
    never shadow, loosen, or drop an upstream one), and its shape is checked so
    a broken extension degrades to findings on that file rather than aborting
    the scan. Membership is exact-case throughout.

  - **Index-staleness** — every `index.md` lists exactly the concept documents
    it owns (a concept document is owned by the nearest `index.md` at or above
    its directory), each with a `description` matching the child's frontmatter,
    and links each child directory's own `index.md`. A directory with no
    `index.md` is absorbed into its nearest ancestor index. The repository root
    `index.md` additionally declares `okf_version`. The prose standard for
    these rules lives in this repo's standards/ tree.

  - **Instrument-spec** — every document typed `Instrument-Spec` carries an
    `## Employed by` section naming the standard, skill, or ritual that demands
    its readings. Presence only: the section's content is review's territory,
    and ref-lint verifies any link it carries.

The concept-document/harness-owned split comes from dev_playbook.md.classify. This hook
asserts unconditionally and fails loud — there is no applicability skip.

Output:
    stdout — one finding per line, `file:line: rule message` (`:line`
             omitted for a file-level finding).
    stderr — one readable summary line.
    exit   — 0 clean, 1 findings, 2 cannot run.

Usage:
    okf-lint [directory]
    okf-lint --list-rules
"""
# /// script
# requires-python = ">=3.14"
# dependencies = ["pyyaml>=6.0"]
# ///

import argparse
import os
import re
import sys
from collections import Counter
from dataclasses import dataclass
from pathlib import Path, PurePosixPath

import yaml

# The dev-playbook checkout this script itself lives in — the pre-commit clone
# in consumer repos, dev-playbook's own working tree when dogfooded. It anchors
# the dev_playbook import below and is the default root the authoritative
# upstream registry is read from (UPSTREAM_REGISTRY_ROOT). A consumer's own
# document-types.md, when present, extends that upstream registry rather than
# replacing it (see check_extension).
HOOK_REPO_ROOT = Path(__file__).resolve().parents[1]

# The tree consumer mode reads the authoritative upstream registry from —
# HOOK_REPO_ROOT by default. Overridable via OKF_LINT_UPSTREAM_ROOT so a test can
# pin a synthetic upstream registry rather than depend on the live dev-playbook
# one (the same synthetic-upstream injection standards-lint does through its
# `hook_repo_root` parameter). Only the registry read is redirected; the
# dev_playbook import below always resolves from the real clone.
UPSTREAM_REGISTRY_ROOT = Path(os.environ.get("OKF_LINT_UPSTREAM_ROOT", HOOK_REPO_ROOT))

sys.path.insert(0, str(HOOK_REPO_ROOT / "src"))

from dev_playbook import md  # noqa: E402
from dev_playbook.findings import print_rules, render  # noqa: E402

# Every rule id this detector can emit, namespaced by the card whose questions
# they answer: `knowledge-organization.*` for that card (frontmatter and
# index freshness) and `instrument.*` for the instruments card (the Employed-by
# rule). Each id is a module-level constant so every emission site references the
# constant, never a raw literal, and RULES (what --list-rules prints) cannot
# drift from what the detector actually emits.
FRONTMATTER = "knowledge-organization.frontmatter"
TYPE = "knowledge-organization.type"
TITLE = "knowledge-organization.title"
DESCRIPTION = "knowledge-organization.description"
RESOURCE = "knowledge-organization.resource"
INDEX = "knowledge-organization.index"
REGISTRY_ROW = "knowledge-organization.registry-row"
DESCRIPTION_SHAPE = "knowledge-organization.description-shape"
INDEX_ORDERING = "knowledge-organization.index-ordering"
TYPE_SHADOWS_UPSTREAM = "knowledge-organization.type-shadows-upstream"
TYPE_LOCATION = "knowledge-organization.type-location"
EMPLOYED_BY = "instrument.employed-by"

RULES = (
    FRONTMATTER,
    TYPE,
    TITLE,
    DESCRIPTION,
    RESOURCE,
    INDEX,
    REGISTRY_ROW,
    DESCRIPTION_SHAPE,
    INDEX_ORDERING,
    TYPE_SHADOWS_UPSTREAM,
    TYPE_LOCATION,
    EMPLOYED_BY,
)

REGISTRY_DOC = "standards/knowledge-organization/document-types.md"
# The canonical consumer template — the file that puts the audited tree in APEX
# mode. Only dev-playbook (or a fixture simulating it) hosts this template;
# consumers copy *from* it and never carry it. Keying apex mode on it rather than
# on the registry document's mere presence is what lets a consumer carry its own
# registry document as a local *extension* without the audit flipping to apex and
# replacing the global registry. This is the same probe standards-lint keys its
# dev-playbook mode on (see CANONICAL_CONFIG in src/dev_playbook/standards_lint.py).
CANONICAL_CONFIG = "standards/build/canonical/.pre-commit-config.yaml"
RESOURCE_REQUIRED_TYPES = {"Recipe-Description"}
# The type reserved to one tree, and that tree. A normative conformance target
# lives under standards/ and nothing else claims the label, so a Standard found
# elsewhere is either misfiled or mistyped — see doc-types/standard/encoding.md.
LOCATION_BOUND_TYPE = "Standard"
STANDARDS_DIR = "standards/"
# The type whose docs must carry an `## Employed by` section, and that section's
# GitHub heading slug — the presence the instrument.employed-by check looks for.
INSTRUMENT_SPEC_TYPE = "Instrument-Spec"
EMPLOYED_BY_SLUG = "employed-by"
BACKTICK_NAME = re.compile(r"`([^`]+)`")
# An index bullet: `- [Title](/root-absolute) — description`. The description
# (group 3) is optional so a malformed entry is caught, not silently skipped.
INDEX_BULLET = re.compile(
    r"^\s*[-*]\s+\[([^\]]*)\]\((/[^)\s]+)\)(?:\s*(?:—|--)\s*(.*\S))?\s*$"
)
# An intro line beginning with this marker declares a meaningful (non-alphabetical)
# order and exempts an index from the ordering check.
ORDERING_MARKER = "Ordering:"

# A directory is a tuple of path parts; the repository root is the empty tuple.
Dir = tuple[str, ...]


class ToolError(Exception):
    """The hook could not complete its scan."""


@dataclass(frozen=True)
class Finding:
    file: str
    rule: str
    message: str
    line: int | None = None

    def render(self) -> str:
        return render(self.file, self.rule, self.message, self.line)


def _is_title_case(name: str) -> bool:
    """Whether every whitespace-separated word of a type name is capitalized.

    ``README`` and ``Recipe-Description`` pass; ``bogus name`` does not. The
    registry document declares Title Case type names, so a backticked-but-
    lowercase cell is a malformed row, not a silently accepted type.
    """
    words = name.split()
    return bool(words) and all(word[0].isupper() for word in words)


def _table_cells(line: str) -> list[str]:
    """The stripped cells of a markdown table row (the pipes removed)."""
    return [cell.strip() for cell in line.strip().strip("|").split("|")]


def _is_separator_row(cells: list[str]) -> bool:
    """Whether a table row is the header/body delimiter (``|---|---|``)."""
    return bool(cells) and all(set(c) <= {"-", ":", " "} for c in cells) and any(
        "-" in c for c in cells
    )


def scan_registry_rows(doc: Path) -> tuple[list[tuple[str, int]], list[int]]:
    """Scan a registry document's `## Types` table without raising.

    Returns ``(valid, malformed)`` — ``valid`` is one ``(name, line)`` pair per
    data row carrying a single backticked Title Case type name in its first
    cell, in table order; ``malformed`` is the line numbers of the data rows
    that do not. Returns two empty lists when the document or its `## Types`
    table is absent — this scanner never raises, so the caller decides whether
    an empty result is a fatal error (the raising `parse_registry` wrapper, for
    the authoritative apex/hook-clone read) or a degradable finding
    (`check_extension`, for a consumer's local extension).
    """
    if not doc.is_file():
        return [], []
    in_types = False
    seen_separator = False
    valid: list[tuple[str, int]] = []
    malformed: list[int] = []
    for line_num, line in md.content_lines(doc):
        heading = md.HEADING_PATTERN.match(line)
        if heading:
            in_types = md.github_slug(heading.group(1)) == "types"
            seen_separator = False
            continue
        if not in_types or not line.lstrip().startswith("|"):
            continue
        cells = _table_cells(line)
        if not seen_separator:
            # The header row and the |---| separator both precede the body; the
            # separator marks where data rows begin.
            if _is_separator_row(cells):
                seen_separator = True
            continue
        first_cell = cells[0] if cells else ""
        name = BACKTICK_NAME.fullmatch(first_cell)
        if name and _is_title_case(name.group(1)):
            valid.append((name.group(1), line_num))
        else:
            malformed.append(line_num)
    return valid, malformed


def parse_registry(registry_root: Path) -> tuple[list[str], list[int]]:
    """Parse the concept-document type names from the authoritative registry.

    The raising wrapper over `scan_registry_rows`, used for the reads that MUST
    succeed: the apex tree's own registry, and the consumer-mode read of the
    hook clone's registry (see `HOOK_REPO_ROOT`). ``registry_root`` is the tree
    that carries the registry document. Returns ``(names, malformed_rows)`` —
    the backticked type names in table order (so the caller can both build the
    registry set and check the declared alphabetical order), and the line
    numbers of malformed rows, which the caller turns into
    `knowledge-organization.registry-row` findings rather than silently dropping
    the type. Raises ToolError when no valid type is parsed — the document is
    absent, or its `## Types` table is missing or has no valid row — since a
    missing authoritative registry means the hook cannot run. The absent-document
    case rides `scan_registry_rows`'s own empty return, so this wrapper does not
    re-stat the file.
    """
    valid, malformed = scan_registry_rows(registry_root / REGISTRY_DOC)
    if not valid:
        raise ToolError(
            f"no usable type registry at {REGISTRY_DOC}: the document is absent "
            "or its '## Types' table has no valid rows"
        )
    return [name for name, _ in valid], malformed


def check_registry(registry_root: Path) -> tuple[set[str], list[Finding]]:
    """Parse the type registry and check its rows' shape and declared order.

    Owns ``parse_registry``: returns the registry set (consumed by the type-lint)
    and its own findings — a ``knowledge-organization.registry-row`` per malformed row and a
    ``knowledge-organization.index-ordering`` when the `## Types` table is not alphabetical by type
    name (the document's intro declares it alphabetical). Called only in apex
    mode — see `main()` — since the registry's shape is dev-playbook's to fix,
    never a consumer's. Raises ToolError if the registry document or its
    `## Types` table is absent.
    """
    type_names, malformed_rows = parse_registry(registry_root)
    findings = _registry_shape_findings(type_names, malformed_rows)
    return set(type_names), findings


def _registry_shape_findings(
    type_names: list[str], malformed_rows: list[int]
) -> list[Finding]:
    """The shape findings shared by the apex registry and a consumer extension.

    A ``knowledge-organization.registry-row`` per malformed row line, then one
    ``knowledge-organization.index-ordering`` when the parsed type names are not
    alphabetical — so a malformed row and an out-of-order table read identically
    wherever the ``## Types`` table is found. The zero-valid-rows and shadow
    findings are not shared: they are consumer-extension-only (apex aborts on an
    empty registry, and the apex registry cannot shadow itself).
    """
    findings = [
        Finding(
            REGISTRY_DOC,
            REGISTRY_ROW,
            "`## Types` row's first cell is not a backticked Title Case type name",
            line=line_num,
        )
        for line_num in malformed_rows
    ]
    if not _is_alphabetical(type_names):
        findings.append(
            Finding(
                REGISTRY_DOC,
                INDEX_ORDERING,
                "`## Types` rows are not in alphabetical order by type name",
            )
        )
    return findings


def check_extension(
    repo_root: Path, upstream: set[str]
) -> tuple[set[str], list[Finding]]:
    """Parse a consumer's local type extension and return its unionable names.

    Consumer mode only. The audited tree's own copy of the registry document is
    a **local extension** of the upstream registry — additive: it may add types,
    never shadow, loosen, or drop an upstream one. Returns
    ``(local_names, findings)``: the valid local type names to union onto the
    effective set, and this file's findings. A broken extension degrades to
    findings on the extension file — never a scan abort — so the walk always
    finishes and the rest of the repo is still checked:

      - ``knowledge-organization.registry-row`` per malformed row (at its line),
        plus one file-level finding when the extension declares zero valid types
        (the raising `parse_registry` would instead abort the whole scan);
      - ``knowledge-organization.index-ordering`` when the `## Types` table is
        not alphabetical, the same order the apex registry declares;
      - ``knowledge-organization.type-shadows-upstream`` per row whose name
        case-insensitively equals an already-declared type — an upstream type
        (e.g. local ``Readme`` beside upstream ``README``) or an earlier row of
        this same extension (e.g. ``API`` after ``Api``). Membership itself stays
        exact-case; this rule is what stops a consumer aliasing a type under a
        different case, whether the aliased type is upstream's or its own.
    """
    valid, malformed_rows = scan_registry_rows(repo_root / REGISTRY_DOC)
    local_names = [name for name, _ in valid]
    findings = _registry_shape_findings(local_names, malformed_rows)
    if not valid:
        findings.append(
            Finding(
                REGISTRY_DOC,
                REGISTRY_ROW,
                "local type extension declares no valid types",
            )
        )
    upstream_lower = {name.lower() for name in upstream}
    seen_lower = set(upstream_lower)
    for name, line_num in valid:
        lowered = name.lower()
        if lowered in seen_lower:
            target = (
                "an upstream type"
                if lowered in upstream_lower
                else "another local type"
            )
            findings.append(
                Finding(
                    REGISTRY_DOC,
                    TYPE_SHADOWS_UPSTREAM,
                    f"local type `{name}` case-insensitively shadows {target}",
                    line=line_num,
                )
            )
        seen_lower.add(lowered)
    return set(local_names), findings


def relpath(path: Path, repo_root: Path) -> str:
    return str(PurePosixPath(path.relative_to(repo_root)))


def dir_of(rel: str) -> Dir:
    return PurePosixPath(rel).parts[:-1]


def frontmatter_of(path: Path) -> tuple[dict | None, str | None]:
    """Parse a doc's frontmatter mapping, or capture why it could not be read.

    Returns ``(mapping, None)`` on success — ``mapping`` is None when the file
    simply carries no frontmatter. Returns ``(None, summary)`` when the file is
    not valid UTF-8 or its YAML frontmatter is malformed, so one broken doc
    becomes a finding against itself instead of a traceback that aborts the
    whole scan and leaves every other file unlinted. The summary is collapsed
    to a single line to keep the one-finding-per-line output contract.
    """
    try:
        return md.parse_frontmatter(path.read_text(encoding="utf-8"))[0], None
    except (OSError, UnicodeDecodeError, yaml.YAMLError) as err:
        return None, " ".join(f"{type(err).__name__}: {err}".split())


def check_types(
    concept_docs: list[str], repo_root: Path, registry: set[str]
) -> list[Finding]:
    findings: list[Finding] = []
    for rel in concept_docs:
        fm, err = frontmatter_of(repo_root / rel)
        if err is not None:
            findings.append(Finding(rel, FRONTMATTER, err))
            continue
        if fm is None:
            findings.append(Finding(rel, TYPE, "no OKF frontmatter"))
            continue
        doctype = fm.get("type")
        if doctype is None:
            findings.append(Finding(rel, TYPE, "missing 'type'"))
        elif doctype not in registry:
            findings.append(
                Finding(rel, TYPE, f"type '{doctype}' not in the registry")
            )
        if not fm.get("title"):
            findings.append(Finding(rel, TITLE, "missing 'title'"))
        description = fm.get("description")
        if not description:
            findings.append(Finding(rel, DESCRIPTION, "missing 'description'"))
        elif isinstance(description, str) and description.rstrip().endswith("."):
            findings.append(
                Finding(
                    rel,
                    DESCRIPTION_SHAPE,
                    "description must not end with a trailing period",
                )
            )
        if doctype in RESOURCE_REQUIRED_TYPES and not fm.get("resource"):
            findings.append(
                Finding(rel, RESOURCE, f"'{doctype}' requires a 'resource'")
            )
        if doctype == LOCATION_BOUND_TYPE and not rel.startswith(STANDARDS_DIR):
            findings.append(
                Finding(
                    rel,
                    TYPE_LOCATION,
                    f"'{LOCATION_BOUND_TYPE}' lives under {STANDARDS_DIR}",
                )
            )
    return findings


def check_instrument_specs(
    concept_docs: list[str], repo_root: Path
) -> list[Finding]:
    """Every `Instrument-Spec` doc carries an `## Employed by` section.

    Presence only: the section names the standard, skill, or ritual that demands
    the instrument's readings, but this check verifies just that the heading
    exists. ref-lint already checks any link the section carries, and whether
    the named consumer is real is review's territory. A frontmatter error is
    reported by check_types, so a doc that fails to parse is skipped here rather
    than double-flagged.
    """
    findings: list[Finding] = []
    for rel in concept_docs:
        fm, err = frontmatter_of(repo_root / rel)
        if err is not None or fm is None:
            continue
        if fm.get("type") != INSTRUMENT_SPEC_TYPE:
            continue
        if EMPLOYED_BY_SLUG not in md.heading_slugs(repo_root / rel):
            findings.append(
                Finding(
                    rel,
                    EMPLOYED_BY,
                    "Instrument Spec has no '## Employed by' section",
                )
            )
    return findings


def nearest_index(start: Dir, index_dirs: set[Dir], *, strict: bool) -> Dir:
    """Nearest index directory at or above `start` (or strictly above if strict).

    The repository root is always an index directory, so this always resolves.
    """
    top = len(start) - 1 if strict else len(start)
    for i in range(top, -1, -1):
        cand = start[:i]
        if cand in index_dirs:
            return cand
    return ()


def parse_index(
    path: Path,
) -> tuple[list[tuple[str, str | None]], list[str], list[str]]:
    """Return (concept_links, child_index_links, invalid_targets) in one index.

    concept_links are (target_relpath, description), in listing order with
    duplicates preserved so a repeated bullet can be flagged; child_index_links
    are the directory-relpaths of linked child `index.md` files; invalid_targets
    are bullet targets that are neither a concept doc nor a child index — a
    harness/excluded path listed by mistake, surfaced rather than dropped.
    Targets are root-absolute `/paths`; fragments are stripped.
    """
    concepts: list[tuple[str, str | None]] = []
    child_indexes: list[str] = []
    invalid: list[str] = []
    for _, line in md.content_lines(path):
        m = INDEX_BULLET.match(line)
        if not m:
            continue
        target = m.group(2).partition("#")[0].lstrip("/")
        description = m.group(3)
        if PurePosixPath(target).name == "index.md":
            child_indexes.append(str(PurePosixPath(target).parent))
        elif md.classify(target) == "concept":
            concepts.append((target, description))
        else:
            invalid.append(target)
    return concepts, child_indexes, invalid


def check_indexes(
    concept_docs: list[str],
    index_docs: list[str],
    repo_root: Path,
) -> list[Finding]:
    findings: list[Finding] = []
    index_dirs: set[Dir] = {dir_of(rel) for rel in index_docs}

    if () not in index_dirs:
        return [Finding("index.md", INDEX, "repository root index.md is missing")]

    # Expected ownership: each concept doc belongs to its nearest index; each
    # non-root index is a child of its nearest ancestor index.
    owned_concepts: dict[Dir, set[str]] = {d: set() for d in index_dirs}
    for rel in concept_docs:
        owner = nearest_index(dir_of(rel), index_dirs, strict=False)
        owned_concepts[owner].add(rel)

    owned_children: dict[Dir, set[Dir]] = {d: set() for d in index_dirs}
    for d in index_dirs:
        if d == ():
            continue
        owned_children[nearest_index(d, index_dirs, strict=True)].add(d)

    for rel in index_docs:
        d = dir_of(rel)
        index_path = repo_root / rel
        listed_concepts, listed_children, invalid_targets = parse_index(index_path)

        for bad in sorted(set(invalid_targets)):
            findings.append(
                Finding(
                    rel, INDEX, f"lists {bad} which is not a concept document"
                )
            )

        # First occurrence wins for the description map; duplicate bullets are
        # flagged separately so a doc cannot be listed twice to hide a wrong
        # description behind a last-wins collapse.
        listed_map: dict[str, str | None] = {}
        for target, description in listed_concepts:
            listed_map.setdefault(target, description)
        listed_targets = set(listed_map)
        counts = Counter(target for target, _ in listed_concepts)
        for dup in sorted(t for t, c in counts.items() if c > 1):
            findings.append(Finding(rel, INDEX, f"lists {dup} more than once"))

        expected = owned_concepts[d]

        for missing in sorted(expected - listed_targets):
            findings.append(Finding(rel, INDEX, f"omits concept doc {missing}"))
        for extra in sorted(listed_targets - expected):
            reason = (
                "does not exist"
                if not (repo_root / extra).is_file()
                else "is not owned by this directory"
            )
            findings.append(Finding(rel, INDEX, f"lists {extra} which {reason}"))
        for target in sorted(expected & listed_targets):
            listed_desc = listed_map[target]
            # A frontmatter error here is already reported by check_types (target
            # is a concept doc); fm is None, so the drift check below is skipped.
            fm, _ = frontmatter_of(repo_root / target)
            actual_desc = fm.get("description") if fm else None
            if listed_desc is None:
                findings.append(
                    Finding(rel, INDEX, f"entry for {target} has no description")
                )
            elif actual_desc is not None and listed_desc != actual_desc:
                findings.append(
                    Finding(
                        rel,
                        INDEX,
                        f"description for {target} does not match its frontmatter",
                    )
                )

        expected_children = {"/".join(c) for c in owned_children[d]}
        listed_child_set = set(listed_children)
        for missing in sorted(expected_children - listed_child_set):
            findings.append(
                Finding(rel, INDEX, f"omits child index {missing}/index.md")
            )
        for extra in sorted(listed_child_set - expected_children):
            findings.append(
                Finding(
                    rel, INDEX, f"lists unexpected child index {extra}/index.md"
                )
            )

    # The root index.md is typeless (not a concept doc), so check_types never
    # sees it; its frontmatter error, if any, is caught only here.
    root_fm, root_err = frontmatter_of(repo_root / "index.md")
    if root_err is not None:
        findings.append(Finding("index.md", FRONTMATTER, root_err))
    elif not root_fm or "okf_version" not in root_fm:
        findings.append(
            Finding("index.md", INDEX, "root index.md must declare okf_version")
        )
    return findings


def _is_alphabetical(titles: list[str]) -> bool:
    """Whether ``titles`` are in case-insensitive alphabetical order."""
    lowered = [t.lower() for t in titles]
    return lowered == sorted(lowered)


def check_index_ordering(index_docs: list[str], repo_root: Path) -> list[Finding]:
    """Flag an index whose entries are not in the standard order.

    Within each group of an index — the concept documents after `README.md`,
    then the child-directory links — entries are alphabetical by link title,
    case-insensitive, and the README.md entry always leads. An intro line
    beginning `Ordering:` declares a meaningful order and exempts an index from
    the two alphabetical checks (only the marker's presence is checked, never its
    prose); the README.md-leads invariant holds regardless of the marker.
    """
    findings: list[Finding] = []
    for rel in index_docs:
        exempt = False
        group_a: list[tuple[str, bool]] = []  # (title, is_readme) in listing order
        child_titles: list[str] = []
        for _, line in md.content_lines(repo_root / rel):
            m = INDEX_BULLET.match(line)
            if m is None:
                # The marker exempts only as an intro line — one before the
                # first listed entry. A marker below the listing is prose, not
                # a declared-order exemption.
                if (
                    not group_a
                    and not child_titles
                    and line.strip().startswith(ORDERING_MARKER)
                ):
                    exempt = True
                continue
            title = m.group(1)
            target = m.group(2).partition("#")[0].lstrip("/")
            base = PurePosixPath(target).name
            if base == "index.md":
                child_titles.append(title)
            elif md.classify(target) == "concept":
                group_a.append((title, base == "README.md"))
        # The README.md entry must lead every index; the Ordering: marker excuses
        # only the two alphabetical checks below, never this invariant.
        readmes = [i for i, (_, is_readme) in enumerate(group_a) if is_readme]
        if readmes and readmes[0] != 0:
            findings.append(
                Finding(
                    rel, INDEX_ORDERING, "the README.md entry must be listed first"
                )
            )
        if exempt:
            continue
        concept_titles = [t for t, is_readme in group_a if not is_readme]
        if not _is_alphabetical(concept_titles):
            findings.append(
                Finding(
                    rel,
                    INDEX_ORDERING,
                    "concept-doc entries are not in alphabetical order by title",
                )
            )
        if not _is_alphabetical(child_titles):
            findings.append(
                Finding(
                    rel,
                    INDEX_ORDERING,
                    "child-directory entries are not in alphabetical order by title",
                )
            )
    return findings


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="okf-lint",
        description="Lint the repo's OKF bundle: concept-doc types, index freshness, and instrument-spec consumers.",
    )
    parser.add_argument(
        "directory",
        nargs="?",
        default=".",
        help="repository root to scan (default: current directory)",
    )
    parser.add_argument(
        "--list-rules",
        action="store_true",
        help="print the rule ids this detector can emit, one per line, and exit",
    )
    args = parser.parse_args(argv)
    if args.list_rules:
        return print_rules(RULES)
    repo_root = Path(args.directory).resolve()
    # Apex mode: the audited repo hosts the canonical consumer template
    # (dev-playbook itself, or a fixture simulating it) — the registry is that
    # tree's own document-types.md, read and shape-checked from there, the sole
    # source of truth with no union and no shadow rule. Consumer mode: every
    # other repo — read the authoritative registry from this script's own hook
    # clone, and if the audited tree carries its own document-types.md, treat it
    # as a local *extension* whose valid types union onto the upstream set
    # (additive-only, no shadowing). Keying on the template rather than on the
    # registry document's mere presence is what keeps a consumer's extension from
    # silently flipping the audit into apex mode and replacing the global registry.
    apex_mode = (repo_root / CANONICAL_CONFIG).is_file()

    try:
        if apex_mode:
            registry, registry_findings = check_registry(repo_root)
        else:
            upstream_names, _malformed_rows = parse_registry(UPSTREAM_REGISTRY_ROOT)
            registry = set(upstream_names)
            registry_findings = []
            if (repo_root / REGISTRY_DOC).is_file():
                local_names, registry_findings = check_extension(repo_root, registry)
                registry = registry | local_names
        all_md = [relpath(p, repo_root) for p in md.find_md_files(repo_root)]
    except (ToolError, OSError) as err:
        print(f"okf-lint: {err}", file=sys.stderr)
        return 2

    concept_docs = [rel for rel in all_md if md.classify(rel) == "concept"]
    index_docs = [rel for rel in all_md if md.classify(rel) == "index"]

    findings = check_types(concept_docs, repo_root, registry)
    findings.extend(check_indexes(concept_docs, index_docs, repo_root))
    findings.extend(check_index_ordering(index_docs, repo_root))
    findings.extend(check_instrument_specs(concept_docs, repo_root))
    findings.extend(registry_findings)

    for f in sorted(findings, key=lambda f: (f.file, f.line or 0, f.rule, f.message)):
        print(f.render())

    scanned = f"{len(concept_docs)} concept docs, {len(index_docs)} indexes"
    if findings:
        print(f"okf-lint: {len(findings)} finding(s) across {scanned}", file=sys.stderr)
        return 1
    print(f"okf-lint: clean across {scanned}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
