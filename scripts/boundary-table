#!/usr/bin/env -S uv run --script
"""boundary-table — write standards/boundaries.yaml, and fail where it disagrees.

Thin shim over dev_playbook.boundary_table.main: it puts the checkout's
``src/`` on ``sys.path`` and calls the module, which derives the boundary
table (every check address the verifier table names, mapped to the gates that
run it: commit, push, ci, or on-demand) from the pre-commit config's stages,
``make -n check``, the workflows' ``run`` steps and their ``SKIP``, and the
ungated registry, then compares it with the committed file (the default) or
writes it (``--write``). Findings print to stdout as GNU finding lines
(``file: standard.rule message``) and exit nonzero if any. ``--list-rules``
prints the rule ids and exits 0. pyyaml is declared below because the module
reads pre-commit configs and workflows. See dev_playbook.boundary_table for
the logic and its tests.
"""
# /// script
# requires-python = ">=3.14"
# dependencies = ["pyyaml>=6.0"]
# ///

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.boundary_table import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
