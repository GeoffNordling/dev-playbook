#!/usr/bin/env -S uv run --script
"""standards-lint — pre-commit validator for the meta-standard's rules.

Thin shim over dev_playbook.standards_lint.main: it puts the checkout's ``src/``
on ``sys.path`` and calls the module, which audits the ``standards/`` tree
against the five meta-standard rules (card-layout, catalog-order, rule-matrix,
hook-surfaces, card-shadows-upstream), printing each finding as a GNU finding
line (``file:line: standard.rule message``) and exiting nonzero if any.
``--list-rules`` prints the rule ids and exits 0. It is a published hook: any
repo can run it over its own ``standards/`` tree, with dev-playbook itself
detected by the canonical consumer template
``standards/build/canonical/.pre-commit-config.yaml`` -- which only the hook repo
hosts. pyyaml is declared below because the module
parses card frontmatter. See dev_playbook.standards_lint for the logic and its
tests.
"""
# /// script
# requires-python = ">=3.14"
# dependencies = ["pyyaml>=6.0"]
# ///

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from dev_playbook.standards_lint import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
