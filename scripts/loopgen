#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""loopgen — check every Loop's graph against the prose around it.

Prototype implementing doc-types/loop/encoding.md: slice, never
interpret. A Loop is `loops/<loop>.md`, typed `Loop`. Its source of truth
is one fenced `mermaid` flowchart; around it sit one paragraph and three
H2s, `Acts`, `Checks`, `Yields`, each a list with one entry per node,
`- id — <link>, fires when … or yields when …`, the id in backticks. A node under no
heading is a receiver, the user or another loop a yield hands control to.

loopgen writes nothing: the view is the graph GitHub renders. `--check`
fails on the first disagreement between graph and prose: a node with no
entry that no yield leads to, an entry with no node, an entry under two
headings, a link that does not resolve or resolves to the wrong type (a
check links a card's Audit cell, `standards/<card>/card.md#audit`), a
missing condition, or an edge the shape does not allow — an act leads to
an act or a check, a check to a check or a yield, a yield back to an act
or out to a receiver, a receiver back to an act.

Usage:
    loopgen --check [ROOT]    check every Loop under ROOT/loops/ (ROOT
                              defaults to the repo this script sits in);
                              exit 1 on the first disagreement
"""

import glob
import os
import re
import sys

LOOP_TYPE = "Loop"
CARD_TYPE = "Standard-Card"
AUDIT_CELL = "audit"
VERBS = ("Acts", "Checks", "Yields")
VERB_OF = {"Acts": "act", "Checks": "check", "Yields": "yield"}
# What each kind of node may lead to. A receiver is a node under no heading.
MAY_LEAD_TO = {
    "act": {"act", "check"},
    "check": {"check", "yield"},
    "yield": {"act", "receiver"},
    "receiver": {"act"},
}
CONDITION_OF = {
    "act": ("fires when", "fires every iteration"),
    "check": ("fires when", "fires every iteration"),
    "yield": ("yields when",),
}

HEADING_RE = re.compile(r"^(#{1,6})\s+(.+?)\s*#*\s*$")
FENCE_RE = re.compile(r"^\s{0,3}(`{3,}|~{3,})\s*(\S*)\s*$")
ENTRY_RE = re.compile(r"^[-*]\s+`([^`]+)`\s+—\s+(.*\S)\s*$")
LINK_RE = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")
# A Mermaid node: an id and an optional shape. The shapes are the flowchart
# set — [text], (text), ([text]), [[text]], [(text)], ((text)), >text], {text},
# {{text}}. The label inside is opaque.
NODE_RE = re.compile(
    r"^([A-Za-z_][\w-]*)"
    r"(\(\[.*?\]\)|\[\[.*?\]\]|\[\(.*?\)\]|\(\(.*?\)\)|\{\{.*?\}\}"
    r"|\[.*?\]|\(.*?\)|\{.*?\}|>.*?\])?$"
)
# An edge between two node terms: an arrow, with an optional |label|.
ARROW_RE = re.compile(r"\s*(?:-->|-\.->|==>|---|-\.-|===)(?:\|[^|]*\|)?\s*")
# Statements that draw nothing loopgen reads.
DIRECTIVE_RE = re.compile(r"^(%%|subgraph\b|end$|direction\b|classDef\b|class\b|style\b|linkStyle\b)")


class LintError(Exception):
    """A form violation in a Loop the checker cannot read."""


# ── frontmatter ──────────────────────────────────────────────────────────


def split_frontmatter(text, path):
    """Split a file into its frontmatter dict and body lines."""
    lines = text.split("\n")
    if lines[0] != "---":
        raise LintError(f"{path}: no frontmatter")
    try:
        end = lines[1:].index("---") + 1
    except ValueError:
        raise LintError(f"{path}: unterminated frontmatter") from None
    meta = {}
    for line in lines[1:end]:
        if not line.strip():
            continue
        key, _, value = line.partition(":")
        meta[key.strip()] = value.strip()
    return meta, lines[end + 1 :]


def type_of(path, root):
    """The frontmatter type of a file a pointer resolves to."""
    with open(path) as f:
        meta, _ = split_frontmatter(f.read(), os.path.relpath(path, root))
    return meta.get("type")


# ── the file: paragraph, graph, verb sections ────────────────────────────


def slice_loop(body_lines, path):
    """Cut a Loop's body into (paragraph lines, mermaid lines, sections).

    Before the fence: the H1 and exactly one paragraph. The fence: one
    `mermaid` block. After it: H2s only, each with the lines beneath it.
    """
    before, mermaid, sections = [], None, []
    fence, in_mermaid, seen_h1 = None, False, False
    for line in body_lines:
        if m := FENCE_RE.match(line):
            marker, info = m.group(1)[0], m.group(2)
            if fence is None:
                fence = marker
                if info == "mermaid":
                    if mermaid is not None:
                        raise LintError(f"{path}: two mermaid blocks; the encoding is one")
                    if sections:
                        raise LintError(f"{path}: the mermaid block sits before the verb sections")
                    mermaid, in_mermaid = [], True
                continue
            if marker == fence:
                fence, in_mermaid = None, False
                continue
        if in_mermaid:
            mermaid.append(line)
            continue
        if fence is None and (m := HEADING_RE.match(line)):
            level, text = len(m.group(1)), m.group(2).strip()
            if level == 1:
                if seen_h1:
                    raise LintError(f"{path}: two H1s")
                seen_h1 = True
                continue
            if mermaid is None:
                raise LintError(f"{path}: heading {text!r} before the graph; only the paragraph sits there")
            if level != 2:
                raise LintError(f"{path}: heading {text!r} is H{level}; the verb sections are H2s with lists")
            sections.append((text, []))
            continue
        if mermaid is None:
            if seen_h1:
                before.append(line)
        elif sections:
            sections[-1][1].append(line)
        elif line.strip():
            raise LintError(f"{path}: text between the graph and the first verb heading: {line.strip()!r}")
    if mermaid is None:
        raise LintError(f"{path}: no mermaid block")
    paragraphs = [p for p in "\n".join(before).split("\n\n") if p.strip()]
    if len(paragraphs) != 1:
        raise LintError(f"{path}: {len(paragraphs)} paragraphs before the graph; the encoding is one")
    return mermaid, sections


def entries_of(sections, path):
    """Map node id → (verb, entry text), from the three verb sections in order."""
    names = [text for text, _ in sections]
    if names != list(VERBS):
        raise LintError(f"{path}: verb sections are {names}; the encoding is {list(VERBS)} in that order")
    entries = {}
    for heading, lines in sections:
        verb = VERB_OF[heading]
        for line in lines:
            if not line.strip():
                continue
            if m := ENTRY_RE.match(line):
                node, rest = m.group(1), m.group(2)
                if node in entries:
                    raise LintError(f"{path}: `{node}` has two entries")
                entries[node] = (verb, rest)
            elif line.startswith((" ", "\t")):
                if not entries:
                    raise LintError(f"{path}: {heading}: continuation line before any entry")
                node = next(reversed(entries))
                entries[node] = (entries[node][0], entries[node][1] + " " + line.strip())
            else:
                raise LintError(
                    f"{path}: {heading}: not an entry, `- `id` — …`: {line.strip()!r}"
                )
    return entries


# ── the graph ────────────────────────────────────────────────────────────


def graph_of(mermaid, path):
    """The node ids and (source, target) edges of a Mermaid flowchart."""
    lines = [l.strip() for l in mermaid if l.strip()]
    if not lines or not lines[0].startswith(("flowchart", "graph")):
        raise LintError(f"{path}: the mermaid block is not a flowchart")
    nodes, edges = set(), []
    for stmt in lines[1:]:
        if DIRECTIVE_RE.match(stmt):
            continue
        if "&" in stmt:
            raise LintError(f"{path}: `&` fan-out is not read; write one edge per line: {stmt!r}")
        terms = ARROW_RE.split(stmt)
        ids = []
        for term in terms:
            m = NODE_RE.match(term.strip())
            if not m:
                raise LintError(f"{path}: cannot read node {term.strip()!r} in {stmt!r}")
            ids.append(m.group(1))
            nodes.add(m.group(1))
        edges.extend(zip(ids, ids[1:]))
    return nodes, edges


# ── the check ────────────────────────────────────────────────────────────


def resolve(link, loop_path, root):
    """The file a link points at: root-absolute `/…` or relative to the Loop."""
    target = link.split("#", 1)[0]
    if target.startswith("/"):
        path = os.path.join(root, target.lstrip("/"))
    else:
        path = os.path.normpath(os.path.join(os.path.dirname(loop_path), target))
    if not os.path.isfile(path):
        raise LintError(f"{os.path.relpath(loop_path, root)}: link {link!r} does not resolve")
    return path


def check_entry(node, verb, rest, loop_path, root):
    """One entry's pointer and condition."""
    rel = os.path.relpath(loop_path, root)
    if not any(phrase in rest for phrase in CONDITION_OF[verb]):
        raise LintError(f"{rel}: `{node}` states no condition ({' / '.join(CONDITION_OF[verb])})")
    links = LINK_RE.findall(rest)
    if verb == "yield":
        if not links and "the user" not in rest:
            raise LintError(f"{rel}: `{node}` names no receiver: the user or a linked Loop")
        for link in links:
            if type_of(resolve(link, loop_path, root), root) != LOOP_TYPE:
                raise LintError(f"{rel}: `{node}` yields to {link!r}, which is not typed Loop")
        return
    if not links:
        raise LintError(f"{rel}: `{node}` links no {'runbook' if verb == 'act' else 'card'}")
    target = resolve(links[0], loop_path, root)
    if verb == "check":
        fragment = links[0].partition("#")[2]
        if type_of(target, root) != CARD_TYPE or fragment != AUDIT_CELL:
            raise LintError(
                f"{rel}: `{node}` checks {links[0]!r}; a check links a card's Audit cell, "
                f"`standards/<card>/card.md#{AUDIT_CELL}`"
            )


def check_loop(loop_path, root):
    """Every rule of the encoding over one Loop; returns its node count."""
    rel = os.path.relpath(loop_path, root)
    with open(loop_path) as f:
        meta, body = split_frontmatter(f.read(), rel)
    if meta.get("type") != LOOP_TYPE:
        raise LintError(f"{rel}: typed {meta.get('type')!r}, not {LOOP_TYPE}")
    mermaid, sections = slice_loop(body, rel)
    entries = entries_of(sections, rel)
    nodes, edges = graph_of(mermaid, rel)
    for node in entries:
        if node not in nodes:
            raise LintError(f"{rel}: `{node}` has an entry but is not a node of the graph")
    kind = {node: entries[node][0] if node in entries else "receiver" for node in nodes}
    yielded_to = {t for s, t in edges if kind[s] == "yield"}
    for node in nodes:
        if kind[node] == "receiver" and node not in yielded_to:
            raise LintError(f"{rel}: `{node}` has no entry and no yield leads to it")
    for s, t in edges:
        if kind[t] not in MAY_LEAD_TO[kind[s]]:
            raise LintError(f"{rel}: edge `{s}` → `{t}` is {kind[s]} → {kind[t]}; the shape does not allow it")
    for node, (verb, rest) in entries.items():
        check_entry(node, verb, rest, loop_path, root)
    return len(nodes)


def all_loops(root):
    """Every file typed Loop under loops/."""
    loops = []
    for path in sorted(glob.glob(os.path.join(root, "loops", "**", "*.md"), recursive=True)):
        if os.path.basename(path) in ("README.md", "index.md"):
            continue
        with open(path) as f:
            meta, _ = split_frontmatter(f.read(), os.path.relpath(path, root))
        if meta.get("type") == LOOP_TYPE:
            loops.append(path)
    return loops


def main(argv):
    """Check every Loop; exit 1 on the first disagreement."""
    if not argv or argv[0] != "--check" or len(argv) > 2:
        print(__doc__)
        return 2
    root = argv[1] if len(argv) == 2 else os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    loops = all_loops(root)
    try:
        counted = sum(check_loop(path, root) for path in loops)
    except LintError as e:
        print(f"FAIL: {e}")
        return 1
    print(f"OK: {len(loops)} loop(s), {counted} node(s), graph and prose agree")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
