+def row_values(received_at: str, payload: str) -> tuple[str | None, ...]:
+    """One event as the row it becomes, in INSERT's column order.
+
+    Both destinations below send exactly this, so a column added to INSERT is
+    added to the sandboxed path in the same edit.
+    """
+    return (received_at, *promoted_values(payload), payload)
+
+
+def send_to_sink(row: tuple[str | None, ...]) -> None:
+    """Hand one row to the receiver the sink file names, over its own connection.
+
+    Used only inside a sandboxed run, where DB_PATH would be a database in the
+    container's own filesystem, thrown away with the container. The receiver is
+    the host process that started the run; it does the insert into the real
+    store, as the user.
+
+    The row goes as one JSON list and the write half is then closed, so the
+    length of the message is the connection itself — nothing to frame and
+    nothing to parse incrementally.
+    """
+    address, port = SINK_PATH.read_text().split()
+    with socket.create_connection(
+        (address, int(port)), timeout=SINK_TIMEOUT_SECONDS
+    ) as sock:
+        sock.sendall(json.dumps(row).encode("utf-8"))
+        sock.shutdown(socket.SHUT_WR)
+
+
